<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 co san tren moi Windows 10/11: bo cai chay TRUOC khi Setup.exe
         cua Velopack cai .NET 8, nen khong dung .NET 8 duoc. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MasterPlay.Installer</RootNamespace>
    <AssemblyName>QuestLog-Setup</AssemblyName>
    <ApplicationIcon>..\MasterPlay.Shell\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Chi phat hanh mot file exe. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\MasterPlay.Shell\app-icon.png" Link="app-icon.png" />
    <Resource Include="..\MasterPlay.Shell\app.ico" Link="app.ico" />
  </ItemGroup>

  <!-- tools\release.ps1 truyen -p:VelopackSetup=<Setup.exe vua dong goi>. Build khong co
       thi bo cai van chay duoc nhung bao thieu goi khi bam Cai dat. -->
  <ItemGroup Condition="'$(VelopackSetup)' != ''">
    <EmbeddedResource Include="$(VelopackSetup)" LogicalName="VelopackSetup.exe" />
  </ItemGroup>

</Project>

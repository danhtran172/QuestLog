<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MasterPlay.Shell</RootNamespace>
    <AssemblyName>QuestLog</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main thay cho Main WPF tu sinh: Velopack phai chay dau tien. -->
    <StartupObject>MasterPlay.Shell.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Man cai dat lan dau phai ghi dung noi Host/Tray se doc. Link nguon thay vi
         tham chieu MasterPlay.Infrastructure: tham chieu se keo EF Core/SQLite vao
         thu muc goc cua ban cai. -->
    <Compile Include="..\MasterPlay.Infrastructure\Configuration\AppPaths.cs" Link="Shared\AppPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- app-icon.png: logo trong thanh tieu de; app.ico: icon cua so (taskbar/alt-tab), co san tung kich thuoc nen khong bi vo. -->
    <Resource Include="app-icon.png" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>


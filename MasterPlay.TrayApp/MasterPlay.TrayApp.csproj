<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Assets\TrayIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MasterPlay.Models\MasterPlay.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.2" />
		<PackageReference Include="CloudinaryDotNet" Version="1.29.2" />

	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Assets\TrayIcon.ico" />
	</ItemGroup>
	<PropertyGroup>
		<ApplicationIcon>Assets\TrayIcon.ico</ApplicationIcon>
	</PropertyGroup>

</Project>
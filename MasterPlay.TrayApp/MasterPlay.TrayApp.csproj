<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyTitle>QuestLog Tray</AssemblyTitle>
		<Product>QuestLog</Product>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Assets\TrayIcon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MasterPlay.Core\MasterPlay.Core.csproj" />
	  <ProjectReference Include="..\MasterPlay.Infrastructure\MasterPlay.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.2" />
		<PackageReference Include="CloudinaryDotNet" Version="1.29.2" />

	</ItemGroup>

	<ItemGroup>
	  <!-- TrayApplicationContext doc thang file nay tu thu muc chay, nen no phai
	       duoc CHEP RA output. `Resource` (khai niem cua WPF) khong lam viec do,
	       thieu file thi tray phai lui ve icon 32px moc tu exe. -->
	  <Content Include="Assets\TrayIcon.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
	<PropertyGroup>
		<ApplicationIcon>Assets\TrayIcon.ico</ApplicationIcon>
	</PropertyGroup>

</Project>

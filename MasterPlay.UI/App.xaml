<Application x:Class="MasterPlay.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MasterPlay.UI"
             StartupUri="Features/Library/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8F9FA"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ReadOnlyInputBackgroundBrush" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="MainTextBrush" Color="#2C3E50"/>
            <SolidColorBrush x:Key="FieldTextBrush" Color="#555555"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#7F8C8D"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
            <SolidColorBrush x:Key="SoftBorderBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="ItemHoverBackground" Color="#ECECEC"/>
            <SolidColorBrush x:Key="ItemSelectedBackground" Color="#D2E3FC"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Style.xaml"/>
                <ResourceDictionary Source="Styles/FilterStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>

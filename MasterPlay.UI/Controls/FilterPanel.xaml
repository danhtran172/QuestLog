<UserControl x:Class="MasterPlay.UI.Controls.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700">
    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource Filter}" FontSize="18" FontWeight="SemiBold" Foreground="#A1BC98"/>
                <CheckBox x:Name="ReverseCheckBox"
                          Content="{DynamicResource ReverseFilter}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource FinishedYear}"/>
                    <ComboBox x:Name="FinishOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="FinishValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Excited}"/>
                    <ComboBox x:Name="ExcitedOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="ExcitedValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Score}"/>
                    <ComboBox x:Name="ScoreOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="ScoreValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource PlaytimeHours}"/>
                    <ComboBox x:Name="PlayTimeOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="PlayTimeValue" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource AveragePlaytime}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AvgVeryLong" Content="{DynamicResource VeryLong}"/>
                    <CheckBox x:Name="AvgLong" Content="{DynamicResource Long}"/>
                    <CheckBox x:Name="AvgMedium" Content="{DynamicResource Medium}"/>
                    <CheckBox x:Name="AvgShort" Content="{DynamicResource Short}"/>
                    <CheckBox x:Name="AvgVeryShort" Content="{DynamicResource VeryShort}"/>
                    <CheckBox x:Name="AvgNone" Content="{DynamicResource None}"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Progress}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="ProgressNextPlay" Content="{DynamicResource NextPlay}"/>
                    <CheckBox x:Name="ProgressDone" Content="{DynamicResource Done}"/>
                    <CheckBox x:Name="ProgressPlaying" Content="{DynamicResource Playing}"/>
                    <CheckBox x:Name="ProgressIntended" Content="{DynamicResource Intended}"/>
                    <CheckBox x:Name="ProgressDrop" Content="{DynamicResource Dropped}"/>
                    <CheckBox x:Name="ProgressPending" Content="{DynamicResource Pending}"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource Ownership}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="OwnReady" Content="{DynamicResource Ready}"/>
                    <CheckBox x:Name="OwnPirated" Content="{DynamicResource Pirated}"/>
                    <CheckBox x:Name="OwnGamePass" Content="{DynamicResource GamePass}"/>
                    <CheckBox x:Name="OwnNotOwned" Content="{DynamicResource NotOwned}"/>
                    <CheckBox x:Name="OwnPSRequired" Content="{DynamicResource PsRequired}"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource MetaScore}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="MetaVeryHigh" Content="{DynamicResource VeryHigh}"/>
                    <CheckBox x:Name="MetaHigh" Content="{DynamicResource High}"/>
                    <CheckBox x:Name="MetaMedium" Content="{DynamicResource Medium}"/>
                    <CheckBox x:Name="MetaLow" Content="{DynamicResource Low}"/>
                    <CheckBox x:Name="MetaVeryLow" Content="{DynamicResource VeryLow}"/>
                    <CheckBox x:Name="MetaNone" Content="{DynamicResource None}"/>
                </StackPanel>
            </UniformGrid>

            <Separator Grid.Row="3" Margin="0,0,0,12"/>

            <Grid Grid.Row="4">
                <Button Content="{DynamicResource Clear}"
                        HorizontalAlignment="Left"
                        Click="Clear_Click"
                        Padding="18,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" Padding="18,6"/>
                    <Button Content="{DynamicResource Apply}"
                            Click="Apply_Click"
                            Padding="18,6"
                            Margin="8,0,0,0"
                            Background="#A1BC98"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="MasterPlay.UI.Controls.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700">
    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Filter" FontSize="18" FontWeight="SemiBold" Foreground="#A1BC98"/>
                <CheckBox x:Name="ReverseCheckBox"
                          Content="Reverse filter"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="Finished year"/>
                    <ComboBox x:Name="FinishOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="FinishValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Excited"/>
                    <ComboBox x:Name="ExcitedOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="ExcitedValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Score"/>
                    <ComboBox x:Name="ScoreOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="ScoreValue" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Playtime hours"/>
                    <ComboBox x:Name="PlayTimeOperator" SelectedIndex="0">
                        <ComboBoxItem Content="="/>
                        <ComboBoxItem Content=">"/>
                        <ComboBoxItem Content=">="/>
                        <ComboBoxItem Content="&lt;"/>
                        <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="PlayTimeValue" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="Average playtime" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AvgVeryLong" Content="Very long"/>
                    <CheckBox x:Name="AvgLong" Content="Long"/>
                    <CheckBox x:Name="AvgMedium" Content="Medium"/>
                    <CheckBox x:Name="AvgShort" Content="Short"/>
                    <CheckBox x:Name="AvgVeryShort" Content="Very short"/>
                    <CheckBox x:Name="AvgNone" Content="None"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Progress" FontWeight="SemiBold"/>
                    <CheckBox x:Name="ProgressNextPlay" Content="Next play"/>
                    <CheckBox x:Name="ProgressDone" Content="Done"/>
                    <CheckBox x:Name="ProgressPlaying" Content="Playing"/>
                    <CheckBox x:Name="ProgressIntended" Content="Intended"/>
                    <CheckBox x:Name="ProgressDrop" Content="Dropped"/>
                    <CheckBox x:Name="ProgressPending" Content="Pending"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Ownership" FontWeight="SemiBold"/>
                    <CheckBox x:Name="OwnReady" Content="Ready"/>
                    <CheckBox x:Name="OwnPirated" Content="Pirated"/>
                    <CheckBox x:Name="OwnGamePass" Content="Game Pass"/>
                    <CheckBox x:Name="OwnNotOwned" Content="Not owned"/>
                    <CheckBox x:Name="OwnPSRequired" Content="PS required"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <TextBlock Text="Metascore" FontWeight="SemiBold"/>
                    <CheckBox x:Name="MetaVeryHigh" Content="Very high"/>
                    <CheckBox x:Name="MetaHigh" Content="High"/>
                    <CheckBox x:Name="MetaMedium" Content="Medium"/>
                    <CheckBox x:Name="MetaLow" Content="Low"/>
                    <CheckBox x:Name="MetaVeryLow" Content="Very low"/>
                    <CheckBox x:Name="MetaNone" Content="None"/>
                </StackPanel>
            </UniformGrid>

            <Separator Grid.Row="3" Margin="0,0,0,12"/>

            <Grid Grid.Row="4">
                <Button Content="Clear"
                        HorizontalAlignment="Left"
                        Click="Clear_Click"
                        Padding="18,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Padding="18,6"/>
                    <Button Content="Apply"
                            Click="Apply_Click"
                            Padding="18,6"
                            Margin="8,0,0,0"
                            Background="#A1BC98"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="MasterPlay.UI.Features.GameEditor.GameEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.Features.GameEditor"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        x:Name="ThisWindow"
        Background="White" FontFamily="Segoe UI"
        PreviewKeyDown="Popup_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Image Source="{Binding PreviewImage}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Border Background="#A0000000">
                <Grid Margin="30,0,30,30" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="42"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxWidth="750">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
            <Button Style="{StaticResource IconButtonStyle}"
                    Background="#3291B6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="25"
                    Command="{Binding ToggleEditModeCommand}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                <Image Source="/Assets/Edit.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,40">


                <StackPanel Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">


                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Score}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <emoji:TextBlock Text="{Binding DisplayScore}"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Emoji"/>
                        </StackPanel>


                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource PlayTime}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,1,0,0"/>
                            <TextBlock Text="{Binding DisplayPlayTime}"
                                       Style="{StaticResource ValueTextStyleNormal}"
                                       Margin="8,0,8,0"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="#2C3E50"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>


                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0"
                                Background="#F9F9F9"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,10,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PublishedDate}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishDate}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Publisher}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Developer}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayDeveloper}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Series}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplaySeries}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Genre}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayGenres}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Segoe UI Emoji"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayThemes}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Segoe UI Emoji"/>
                                </Grid>
                            </StackPanel>
                        </Border>


                        <Border Grid.Column="1"
                                Background="#F9F9F9"
                                CornerRadius="8"
                                Padding="15"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="{DynamicResource MetaScore}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding CheckMetaScoreCommand}"
                                                ToolTip="{DynamicResource CheckMetaScore}"
                                                Width="12"
                                                Height="12"
                                                Margin="2,-2,0,0"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding HasSlugName, Converter={StaticResource BoolToVis}}">
                                            <Image Source="/Assets/Question.png"
                                                   Width="12"
                                                   Height="12"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                        Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                             CornerRadius="4"
                                             Padding="4,1"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayMetaScore}"
                                            Foreground="#2C3E50"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Padding="2,0"
                                            Background="Transparent"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="{DynamicResource AvgPlaytime}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding CheckPlayTimeCommand}"
                                                ToolTip="{DynamicResource CheckPlaytime}"
                                                Width="12"
                                                Height="12"
                                                Margin="2,-2,0,0"
                                                VerticalAlignment="Top">
                                            <Image Source="/Assets/Question.png"
                                                   Width="12"
                                                   Height="12"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayAvgPlayTime}"
                                               Style="{StaticResource ValueTextStyle}"
                                               FontWeight="Normal"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Excited}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayExcited}"
                                               Style="{StaticResource ValueTextStyle}"
                                               FontWeight="Normal"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               FontFamily="Segoe UI Emoji"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ownership}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <emoji:TextBlock Grid.Column="1"
                                               Text="{Binding DisplayOwnership}"
                                               Foreground="{Binding SelectedOwnership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}"
                                               Style="{StaticResource ValueTextStyle}"
                                               FontWeight="Normal"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               FontFamily="Segoe UI Emoji"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PlayProgress}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <emoji:TextBlock Grid.Column="1"
                                               Text="{Binding DisplayProgress}"
                                               Foreground="{Binding SelectedProgress, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Progress}"
                                               Style="{StaticResource ValueTextStyle}"
                                               FontWeight="Normal"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               FontFamily="Segoe UI Emoji"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource FinishedIn}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayFinishedIn}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>


                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource ProcessName}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayProcessName}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            </Grid>


                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding HasInitExeNameForView, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource LaunchGameProcess}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayInitProcessName}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource SaveLocation}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplaySaveFolderPath}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding OpenSaveFolderCommand}"
                                        IsEnabled="{Binding SaveFolderAccessible}"
                                        Opacity="{Binding SaveFolderAccessible, Converter={StaticResource BoolToOpacity}}">
                                    <Image Source="/Assets/OpenFolder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource BackupFolder}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayBackupFolderPath}"
                                           Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding OpenBackupFolderCommand}"
                                        IsEnabled="{Binding BackupFolderAccessible}"
                                        Opacity="{Binding BackupFolderAccessible, Converter={StaticResource BoolToOpacity}}">
                                    <Image Source="/Assets/OpenFolder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <StackPanel Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}">


                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20" Padding="15">
                        <StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource GameName}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="10,0,0,0"
                                        Background="#6FA4AF" Command="{Binding SyncCommand}"
                                        ToolTip="{DynamicResource SyncGameData}">
                                    <Image Source="/Assets/Clound Sync.png" Width="18" Height="18"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Score}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="80" HorizontalContentAlignment="Center"
                                             Text="{Binding Score, TargetNullValue='', UpdateSourceTrigger=LostFocus}"
                                             Height="28" Padding="8,4" PreviewTextInput="Score_PreviewTextInput"/>
                                </StackPanel>
                            </Grid>


                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource PlayTime}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBox Width="60" HorizontalContentAlignment="Center" Text="{Binding PlayTimeHours, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                        <TextBlock Text="h" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,100,0">
                                        <TextBox Width="45" HorizontalContentAlignment="Center" Text="{Binding PlayTimeMinutes, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                        <TextBlock Text="m" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="0,0,4,0"
                                                Command="{Binding AdjustPlayTimeDownCommand}" ToolTip="{DynamicResource SubtractMinutes}"
                                                Width="20" Height="20">
                                            <Image Source="/Assets/Minus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                        <TextBox Width="55" Text="{Binding AdjustMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                                        <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="4,0,0,0"
                                                Command="{Binding AdjustPlayTimeUpCommand}" ToolTip="{DynamicResource AddMinutes}"
                                                Width="20" Height="20">
                                            <Image Source="/Assets/Plus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>


                        <Border Grid.Column="0" Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PublishedDate}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding PublishDateInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="8,4"/>
                                </Grid>


                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Publisher}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="8,4"/>
                                </Grid>


                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Developer}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" Padding="8,4"/>
                                </Grid>


                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Series}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                                    <Button Grid.Column="1"
                                            x:Name="SeriesButton"
                                            Style="{StaticResource TagInputButtonStyle}"
                                            Command="{Binding OpenSeriesPopupCommand}"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch">
                                        <WrapPanel x:Name="SeriesWrapPanel">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedSeries}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <Border Style="{StaticResource TagChipStyle}">
                                                <TextBlock Text="{Binding SelectedSeries.Name}" Foreground="#2C3E50" FontSize="13"/>
                                            </Border>
                                        </WrapPanel>
                                    </Button>

                                    <Popup x:Name="SeriesPopup"
                                           IsOpen="{Binding IsSeriesPopupOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=SeriesButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Slide" Width="320"
                                           PreviewKeyDown="Popup_PreviewKeyDown"
                                           >
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="0">
                                            <Grid MinHeight="300" MaxHeight="400">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>


                                                <WrapPanel Grid.Row="0" Margin="8,8,8,0" x:Name="SelectedSeriesPanel">
                                                    <WrapPanel.Style>
                                                        <Style TargetType="WrapPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedSeries}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </WrapPanel.Style>
                                                    <Border Style="{StaticResource TagChipStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SelectedSeries.Name}" Foreground="#2C3E50" FontSize="13"/>
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource TagRemoveButtonStyle}"
                                                                    Command="{Binding RemoveSelectedSeriesCommand}"/>
                                                        </Grid>
                                                    </Border>
                                                </WrapPanel>


                                                <TextBox Grid.Row="1"
                                                         Text="{Binding SeriesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PopupSearchBoxStyle}"
                                                         Margin="8,8,8,0"/>


                                                <ScrollViewer Grid.Row="2"
                                                              Margin="8,8,8,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding FilteredSeries}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0"
                                                                            Style="{StaticResource PopupItemStyle}" Width="120"
                                                                            MouseLeftButtonUp="SeriesItem_MouseLeftButtonUp"
                                                                            Tag="{Binding}">
                                                                        <emoji:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#2C3E50" FontFamily="Segoe UI Emoji"/>
                                                                    </Border>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource IconButtonStyle}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Width="20" Height="20"
                                                                            Margin="0"
                                                                            HorizontalAlignment="Right"
                                                                            Command="{Binding DataContext.OpenEditSeriesPopupCommand, ElementName=ThisWindow}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{DynamicResource EditSeriesTip}">
                                                                        <Image Source="/Assets/More.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>


                                                <Border Grid.Row="3"
                                                        Style="{StaticResource PopupCreateNewStyle}"
                                                        Visibility="{Binding SeriesSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                        MouseLeftButtonUp="CreateNewSeries_MouseLeftButtonUp">
                                                    <emoji:TextBlock Text="{Binding CreateNewSeriesText}"
                                                               FontSize="13"
                                                               Foreground="#FF88BA"
                                                               Margin="10,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe UI Emoji"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>


                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Genre}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                                    <Button Grid.Column="1"
                                            x:Name="GenresButton"
                                            Style="{StaticResource TagInputButtonStyle}"
                                            Command="{Binding OpenGenresPopupCommand}"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch">
                                        <ItemsControl ItemsSource="{Binding SelectedGenres}">
                                            <ItemsControl.ItemsPanel>

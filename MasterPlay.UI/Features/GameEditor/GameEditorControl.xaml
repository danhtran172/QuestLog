                                <TextBox Grid.Column="1" Text="{Binding SaveFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding EditSaveFolderCommand}" IsEnabled="{Binding SaveFolderAccessible}">
                                    <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource BackupFolder}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding BackupFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding EditBackupFolderCommand}" IsEnabled="{Binding BackupFolderAccessible}">
                                    <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Background="#6FA4AF" Margin="8,0,0,0"
                                        Command="{Binding GenerateBackupFolderCommand}" ToolTip="{DynamicResource GenerateBackupFolder}">
                                    <Image Source="/Assets/Generate.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource CoverImageUrl}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButtonStyle}"
                                        Background="#6FA4AF"
                                        Margin="15,0,0,0"
                                        Command="{Binding SyncCoverCommand}"
                                        ToolTip="{DynamicResource RefreshPreviewImage}">
                                    <Image Source="/Assets/Clound Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource GalleryImagePath}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding GImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButtonStyle}"
                                        Background="#6FA4AF"
                                        Margin="15,0,0,0"
                                        Command="{Binding SyncGalleryCommand}"
                                        ToolTip="{DynamicResource RefreshGalleryImage}">
                                    <Image Source="/Assets/Clound Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>


                            <Grid>
                                <Border Width="460" Height="215" HorizontalAlignment="Center"
                                        SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.14"/>
                                    </Border.Effect>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding GImagePath, Converter={StaticResource SteamImgConv}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>


        <Border Grid.Row="2"
                Padding="20,15"
                BorderBrush="#F5F5F5"
                BorderThickness="0,1,0,0"
                Background="#FAFAFA">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Direction="315"
                                  ShadowDepth="3"
                                  BlurRadius="8"
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#E74C3C"
                           FontStyle="Italic"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="50,0,0,0"/>


                <Button Style="{StaticResource IconButtonStyle}"
                        Background="#A94A4A"
                        HorizontalAlignment="Left"
                        Command="{Binding DeleteGameCommand}"
                        ToolTip="{DynamicResource DisableGame}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                    <Image Source="/Assets/Delete.png"
                           Width="20"
                           Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>


                <Button Style="{StaticResource IconButtonStyle}"
                        Background="#DDAED3"
                        HorizontalAlignment="Left"
                        Command="{Binding FinishGameCommand}"
                        ToolTip="{DynamicResource MarkAsFinished}"
                        Visibility="{Binding CanFinish, Converter={StaticResource BoolToVis}}">
                    <Image Source="/Assets/Finish3.png"
                           Width="20"
                           Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Background="#708A58"
                                Command="{Binding SaveCommand}">
                            <Image Source="/Assets/Save.png"
                                   Width="20"
                                   Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="12,0,0,0"
                                Command="{Binding CancelCommand}">
                            <Image Source="/Assets/Back3.png"
                                   Width="20"
                                   Height="20"
                                   Margin="0,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="12,0,0,0"
                            Command="{Binding CloseCommand}"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                        <Image Source="/Assets/Close.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="PopupBackdrop"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#91000000"
                Visibility="{Binding IsAnyPopupOpen, Converter={StaticResource BoolToVis}}"/>

        <Popup x:Name="FinishPopup"
               IsOpen="{Binding IsFinishPopupOpen, Mode=TwoWay}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               PreviewKeyDown="Popup_PreviewKeyDown">
            <Border Width="200" Height="150"
                    CornerRadius="10"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource EnterScore}"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1"
                             x:Name="FinishScoreTextBox"
                             Text="{Binding FinishScoreInput, UpdateSourceTrigger=PropertyChanged}"
                             Width="70"
                             Height="50"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="18"
                             PreviewTextInput="FinishScore_PreviewTextInput"/>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,0">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Background="#708A58"
                                Command="{Binding FinishSaveCommand}"
                                Margin="0,0,10,0">
                            <Image Source="/Assets/Save.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding FinishCancelCommand}">
                            <Image Source="/Assets/Back3.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>



        <Popup x:Name="EditSeriesPopup"
               IsOpen="{Binding IsEditSeriesPopupOpen, Mode=TwoWay}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               PreviewKeyDown="Popup_PreviewKeyDown">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource EditSeries}" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditSeriesName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58"
                                Command="{Binding SaveSeriesEditCommand}" ToolTip="{DynamicResource Save}">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteSeriesCommand}" ToolTip="{DynamicResource Delete}">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditSeriesCommand}" ToolTip="{DynamicResource Cancel}">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>


        <Popup x:Name="EditGenrePopup"
               IsOpen="{Binding IsEditGenrePopupOpen, Mode=TwoWay}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               PreviewKeyDown="Popup_PreviewKeyDown">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource EditGenre}" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditGenreName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58"
                                Command="{Binding SaveGenreEditCommand}" ToolTip="{DynamicResource Save}">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteGenreCommand}" ToolTip="{DynamicResource Delete}">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditGenreCommand}" ToolTip="{DynamicResource Cancel}">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>


        <Popup x:Name="EditThemePopup"
               IsOpen="{Binding IsEditThemePopupOpen, Mode=TwoWay}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               PreviewKeyDown="Popup_PreviewKeyDown">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource EditTheme}" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditThemeName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58"
                                Command="{Binding SaveThemeEditCommand}" ToolTip="{DynamicResource Save}">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteThemeCommand}" ToolTip="{DynamicResource Delete}">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditThemeCommand}" ToolTip="{DynamicResource Cancel}">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

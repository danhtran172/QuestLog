<UserControl x:Class="MasterPlay.UI.Features.GameEditor.OwnershipInfoEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="#EEF4FF"
                BorderBrush="#66C0F4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20"
                Visibility="{Binding IsSteamOffOwnership, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource SteamOffInformation}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MainTextBrush}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource SteamAccount}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SteamAccount, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Padding="8,4"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SteamPassword, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Padding="8,4"/>
                </Grid>

                <Separator Margin="0,2,0,12"/>

                <StackPanel Visibility="{Binding HasUbisoftPublisher, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource UbisoftConnectAccount}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Account}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding UbisoftAccount, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Padding="8,4"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding UbisoftPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Padding="8,4"/>
                    </Grid>

                    <Separator Margin="0,2,0,12"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource SupportDocument}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SupportDocumentUrl, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Padding="8,4"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Note}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OwnershipNote, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="70"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="#FFF5EF"
                BorderBrush="#D98C5F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,20"
                Visibility="{Binding IsPiratedOwnership, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource PiratedInformation}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MainTextBrush}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource DownloadLink}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             Padding="8,4"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Note}" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OwnershipNote, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="70"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

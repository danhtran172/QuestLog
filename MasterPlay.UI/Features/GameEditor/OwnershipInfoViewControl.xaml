<UserControl x:Class="MasterPlay.UI.Features.GameEditor.OwnershipInfoViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#DDE8FA"/>
            <Setter Property="BorderBrush" Value="#AFC7E8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#315F9C"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding IsOwnershipInfoVisible, Converter={StaticResource BoolToVis}}">
        <Border Background="#EEF4FF"
                BorderBrush="#66C0F4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10"
                Visibility="{Binding IsSteamOffOwnership, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Button Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenOwnershipLinkCommand}"
                        CommandParameter="{Binding SupportDocumentUrl}"
                        Visibility="{Binding HasSupportDocument, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource MoreInfo}"/>
                </Button>

                <WrapPanel Margin="0,4,0,12">
                    <Border Width="230"
                            MinHeight="110"
                            BorderBrush="#8AAFD7"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="#F8FBFF"
                            Padding="12"
                            Margin="0,0,12,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SteamAccount}"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource AccountShort}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SteamAccount}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Content="⧉"
                                        ToolTip="{DynamicResource Copy}"
                                        Command="{Binding CopyOwnershipValueCommand}"
                                        CommandParameter="{Binding SteamAccount}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource PasswordShort}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SteamPassword}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Content="⧉"
                                        ToolTip="{DynamicResource Copy}"
                                        Command="{Binding CopyOwnershipValueCommand}"
                                        CommandParameter="{Binding SteamPassword}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Width="230"
                            MinHeight="110"
                            BorderBrush="#8AAFD7"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="#F8FBFF"
                            Padding="12"
                            Margin="0,0,12,8"
                            Visibility="{Binding HasUbisoftAccountData, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UbisoftConnectAccount}"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource AccountShort}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UbisoftAccount}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Content="⧉"
                                        ToolTip="{DynamicResource Copy}"
                                        Command="{Binding CopyOwnershipValueCommand}"
                                        CommandParameter="{Binding UbisoftAccount}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource PasswordShort}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UbisoftPassword}" Margin="5,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Content="⧉"
                                        ToolTip="{DynamicResource Copy}"
                                        Command="{Binding CopyOwnershipValueCommand}"
                                        CommandParameter="{Binding UbisoftPassword}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border BorderBrush="#AFC7E8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="#F8FBFF"
                        Padding="12"
                        MinHeight="75">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Note}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding OwnershipNote}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Background="#FFF5EF"
                BorderBrush="#D98C5F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10"
                Visibility="{Binding IsPiratedOwnership, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Button Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenOwnershipLinkCommand}"
                        CommandParameter="{Binding DownloadUrl}"
                        Visibility="{Binding HasDownloadLink, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource DownloadPage}"/>
                </Button>
                <Border BorderBrush="#E0B28F"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="#FFFBF8"
                        Padding="12"
                        MinHeight="90"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Note}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding OwnershipNote}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

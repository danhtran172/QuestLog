<Window x:Class="MasterPlay.UI.Features.Library.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.Features.Library"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:shared="clr-namespace:MasterPlay.UI.Shared.Controls"
        xmlns:input="clr-namespace:MasterPlay.UI.Services.Input"
        Title="Questory"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI, Segoe UI Emoji"
        KeyDown="Window_KeyDown"
        xmlns:local="clr-namespace:MasterPlay.UI.Features.Queue"
        xmlns:controls="clr-namespace:MasterPlay.UI.Features.Library"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">


    <Window.Resources>

        <SolidColorBrush x:Key="HighlightBrush" Color="Transparent"/>

        <DataTemplate x:Key="GameGenrePillTemplate">
            <Border Background="#EDF7EB" BorderBrush="#B9DAB4" BorderThickness="1" CornerRadius="10" Padding="5,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconData, Converter={StaticResource Base64ImageConverter}}" Visibility="{Binding IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Width="12" Height="12" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#315A2B" ToolTip="{Binding Name}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameThemePillTemplate">
            <Border Background="#F1F0FA" BorderBrush="#C7C3E7" BorderThickness="1" CornerRadius="10" Padding="5,2" Margin="0,0,4,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconData, Converter={StaticResource Base64ImageConverter}}" Visibility="{Binding IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Width="12" Height="12" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#4D4A82" ToolTip="{Binding Name}"/>
                </StackPanel>
            </Border>
        </DataTemplate>


        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="25"/>
                                                </Grid.ColumnDefinitions>
                                                <Image x:Name="Icon"
                                               Grid.Column="0" Width="14" Height="14"
                                               Margin="10,0,6,0" VerticalAlignment="Center"
                                               Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <ContentPresenter x:Name="Content"
                                                          Grid.Column="1"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path Grid.Column="2"
                                              Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                              Fill="{DynamicResource FieldTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Content" Property="Grid.Column" Value="0"/>
                                                <Setter TargetName="Content" Property="Grid.ColumnSpan" Value="3"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           Focusable="False">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="12"
                                Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <StackPanel>

                                        <ItemsPresenter SnapsToDevicePixels="True"/>

                                        <CheckBox x:Name="ReverseCheckBox"
                                          Content="{DynamicResource Reverse}"
                                          Margin="8,4,8,8"
                                          IsChecked="{Binding DataContext.IsReverseSort, RelativeSource={RelativeSource AncestorType=Window}}"
                                          VerticalAlignment="Center"
                                          FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="20,0,20,0" Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                        <Button Content="{DynamicResource Default}" Command="{Binding ShowAllCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource Planning}" Command="{Binding ShowPlanningCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlanMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource Finished}" Command="{Binding ShowFinishedCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinishMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource PlayQueue}" Command="{Binding ShowPlayQueueCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayQueueMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>


                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Width="220" Height="30" Background="Transparent" CornerRadius="20"
                            Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource ModernSearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,100,0"
                                     />
                            <Border HorizontalAlignment="Right" Width="94" Height="28" Margin="0,0,1,0" Background="Transparent">
                                <ComboBox x:Name="SearchByComboBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="0"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          VerticalContentAlignment="Center"
                                          HorizontalContentAlignment="Center"
                                          Padding="0"
                                          SelectionChanged="SearchByComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource All}" Tag="All"/>
                                    <ComboBoxItem Content="{DynamicResource Name}" Tag="Name"/>
                                    <ComboBoxItem Content="{DynamicResource Series}" Tag="Series"/>
                                    <ComboBoxItem Content="{DynamicResource Publisher}" Tag="Publisher"/>
                                    <ComboBoxItem Content="{DynamicResource Developer}" Tag="Developer"/>
                                    <ComboBoxItem Content="{DynamicResource Release}" Tag="Release"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </Border>


                    <ComboBox x:Name="SortComboBox"
                              Width="115"
                              Style="{StaticResource SortComboBoxStyle}"
                              SelectionChanged="SortComboBox_SelectionChanged"
                              Tag="/Assets/Sort.png"
                              SelectedIndex="0"
                              Margin="10,0,5,0"
                              Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                        <ComboBoxItem Content="{DynamicResource Default}"/>
                        <ComboBoxItem Content="{DynamicResource Status}"/>
                        <ComboBoxItem Content="{DynamicResource Name}"/>
                        <ComboBoxItem Content="{DynamicResource PlayTime}"/>
                        <ComboBoxItem Content="{DynamicResource Publish}"/>
                        <ComboBoxItem Content="{DynamicResource MetaScore}"/>
                        <ComboBoxItem Content="{DynamicResource Excited}"/>
                        <ComboBoxItem Content="{DynamicResource Score}"/>
                        <ComboBoxItem Content="{DynamicResource Ownership}"/>
                        <ComboBoxItem Content="{DynamicResource Progress}"/>
                        <ComboBoxItem Content="{DynamicResource AvgPlaytime}"/>
                    </ComboBox>

                    <ToggleButton x:Name="FilterToggleButton"
                                  Style="{StaticResource FilterButtonStyle}"
                                  Background="Transparent"
                                  Margin="0,0,5,0"
                                  Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#A1BC98"
                            Command="{Binding AddGameCommand}">
                        <Image Source="/Assets/Add.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#7F8C8D"
                            Margin="10,0,0,0"
                            Command="{Binding OpenSettingsCommand}">
                        <Image Source="/Assets/Setting.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <Popup x:Name="FilterPopup"
               Placement="Center"
               StaysOpen="False"
               PopupAnimation="Slide"
               AllowsTransparency="True"
               Opened="FilterPopup_Opened"
               IsOpen="{Binding IsChecked, ElementName=FilterToggleButton, Mode=TwoWay}">
            <controls:FilterPanel x:Name="FilterPanel" CloseRequested="FilterPanel_CloseRequested"/>
        </Popup>


        <Grid Grid.Row="1" Margin="5">

            <ScrollViewer x:Name="CardScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameViewModel}">
                            <Border x:Name="GameCard"
                                    Width="270"
                                    Margin="6"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="14"
                                    Focusable="True"
                                    KeyboardNavigation.IsTabStop="True"
                                    GotKeyboardFocus="GameCard_GotKeyboardFocus"
                                    input:ControllerNavigationProperties.SelectCommand="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    input:ControllerNavigationProperties.PlayCommand="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#E4E4E4"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#5B9BD5"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>


                                    <Border Grid.Row="0"
                                            Height="126.2"
                                            CornerRadius="14,14,0,0"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Game.GImagePath, Converter={StaticResource SteamImgConv}}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>


                                    <Grid Grid.Row="1" Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="*"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>


                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,0,15"/>


                                        <Grid Grid.Row="2">

                                            <StackPanel Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PublishedLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishYear}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{DynamicResource MetaScoreLabel}" FontWeight="Bold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                                CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayMetaScore}" Foreground="{DynamicResource MainTextBrush}" FontSize="12" FontWeight="Bold" Padding="2,0"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PublisherLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PlaytimeLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowFinishedIn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource FinishedInLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayFinishedIn}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>



                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource SeriesLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplaySeries}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource DeveloperLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Game.Developer}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PublisherLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PlaytimeLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource ExcitedLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <shared:FireValueControl Grid.Column="1" Text="{Binding DisplayExcited}" Value="{Binding Game.Excited}" FontSize="12" ToolTip="{Binding DisplayExcited}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource ScoreLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <shared:FireValueControl Grid.Column="1" Text="{Binding DisplayScore}" Value="{Binding Game.Score}" FontSize="12" ToolTip="{Binding DisplayScore}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource OwnershipLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Image Source="{Binding Game.Ownership.IconData, Converter={StaticResource Base64ImageConverter}}" Visibility="{Binding Game.Ownership.IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <emoji:TextBlock Text="{Binding DisplayOwnership}" Foreground="{Binding Game.Ownership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                    </StackPanel>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>

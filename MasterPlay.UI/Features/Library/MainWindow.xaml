                                                        <Image Source="{Binding Game.Progress.IconData, Converter={StaticResource Base64ImageConverter}}" Visibility="{Binding Game.Progress.IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Width="16" Height="16" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding DisplayProgress}" Foreground="{Binding Game.Progress, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Progress}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{DynamicResource PublishedLabel}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishYear}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>


                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <Grid Grid.Column="0" Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Image Width="18" Height="18" VerticalAlignment="Center" Source="/Assets/Problem.png" Margin="2,2,2,2" Stretch="Fill" ToolTip="{Binding FolderWarningInfo}"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"
                                                       Visibility="{Binding ShowFolderWarning, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PlayButtonStyle}"
            Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}"
            Margin="0,0,10,0"
            Focusable="False"
            Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}"
            IsEnabled="{Binding IsGameRunning, Converter={StaticResource BoolInverse}}">
                                                    <Image Width="16" Height="16"
               Source="/Assets/Play.png"
               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource InfoButtonStyle}"
                                                        Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Focusable="False">
                                                    <Image Source="/Assets/Info.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>


            <Border x:Name="ListBorder"
                    Grid.Row="1"
                    Margin="5"
                    Visibility="{Binding IsPlayQueueMode, Converter={StaticResource BoolToVis}}">
                <local:QueueView/>
            </Border>
        </Grid>


        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="25,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                   x:Name="PaginationSummaryTextBlock"
                   Text="{Binding PaginationSummaryText}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="#666666"/>


                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,16,0"
                    Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                    <Button x:Name="PrevPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="{DynamicResource Previous}"
                    Click="PrevPageButton_Click"
                    IsEnabled="{Binding CanGoPrev}"/>
                    <TextBlock x:Name="PageInfoTextBlock"
                       Text="{Binding PageInfoText}"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource FieldTextBrush}"/>
                    <Button x:Name="NextPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="{DynamicResource Next}"
                    Click="NextPageButton_Click"
                    IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>


                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock Text="Questory by Vidagrr @2026" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text=" | " Margin="10,0" Foreground="#666666"/>
                    <TextBlock Text="Version 1.3" FontSize="12" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="FilterBackdrop"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#91000000"
                Visibility="{Binding IsChecked, ElementName=FilterToggleButton, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>

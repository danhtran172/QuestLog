<UserControl x:Class="MasterPlay.UI.Features.Queue.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MasterPlay.UI.Converters"
             xmlns:dragDrop="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:shared="clr-namespace:MasterPlay.UI.Shared.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:SteamImageConverter x:Key="SteamImgConv"/>
        <converters:MetaScoreColorConverter x:Key="MetaScoreColorConverter"/>
        <converters:SelectionColorConverter x:Key="SelectionColorConverter"/>
        <Style TargetType="TextBlock" x:Key="QueueTextStyle">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <ListView x:Name="QueueListView"
              ItemsSource="{Binding Games}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              VirtualizingPanel.ScrollUnit="Pixel"
              BorderThickness="0"
              Background="Transparent"
              Padding="0"
              Margin="0"
              ItemContainerStyle="{StaticResource ListViewItemStyle}"
              HorizontalContentAlignment="Stretch"
              dragDrop:DragDrop.IsDragSource="True"
              dragDrop:DragDrop.IsDropTarget="True"
              dragDrop:DragDrop.UseDefaultDragAdorner="True"
              dragDrop:DragDrop.UseDefaultEffectDataTemplate="True"
              dragDrop:DragDrop.DropHandler="{Binding}"
              MouseDoubleClick="QueueListView_MouseDoubleClick">
        <ListView.View>
            <GridView ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}">

                <GridViewColumn Width="40">
                    <GridViewColumn.Header>
                        <TextBlock Text="" Margin="2,0"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="30" Height="30"
                                    CornerRadius="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="/Assets/Drag.png"
                                       Width="20" Height="20"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="142">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Image}" Foreground="{DynamicResource MainTextBrush}"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="140" Height="65" CornerRadius="4"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Game.GImagePath, Converter={StaticResource SteamImgConv}}"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center"
                                                AlignmentY="Center"/>
                                </Border.Background>
                            </Border>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="180">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Name}" Foreground="{DynamicResource MainTextBrush}"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource QueueTextStyle}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       Padding="0"
                                       Margin="0"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="110">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Progress}" Foreground="{DynamicResource MainTextBrush}"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Game.Progress.IconData, Converter={StaticResource Base64ImageConverter}}"
                                       Visibility="{Binding Game.Progress.IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                       Width="16" Height="16" Margin="0,0,4,0"
                                       RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                <TextBlock Text="{Binding DisplayProgress}"
                                           Foreground="{Binding Game.Progress, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Progress}"
                                           VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="90">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Excited}" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <shared:FireValueControl Text="{Binding DisplayExcited}"
                                                     Value="{Binding Game.Excited}"
                                                     Foreground="{DynamicResource MainTextBrush}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Margin="0"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="90">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Published}" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayPublishYear}"
                                       Style="{StaticResource QueueTextStyle}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="90">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource MetaScore}" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    dragDrop:DragDrop.DragSourceIgnore="True">
                                <TextBlock Text="{Binding DisplayMetaScore}"
                                           Foreground="{DynamicResource MainTextBrush}"
                                           FontWeight="Bold"
                                           Margin="0"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="90">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource AvgPlay}" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayAvgPlayTime}"
                                       Style="{StaticResource QueueTextStyle}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"/>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Width="110">
                    <GridViewColumn.Header>
                        <TextBlock Text="{DynamicResource Ownership}" Foreground="{DynamicResource MainTextBrush}"/>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Game.Ownership.IconData, Converter={StaticResource Base64ImageConverter}}"
                                       Visibility="{Binding Game.Ownership.IconData, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                       Width="16" Height="16" Margin="0,0,5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <emoji:TextBlock Text="{Binding DisplayOwnership}"
                                                 Foreground="{Binding Game.Ownership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Segoe UI Emoji"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

            </GridView>
        </ListView.View>
    </ListView>
</UserControl>

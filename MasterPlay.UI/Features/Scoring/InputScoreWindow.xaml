<Window x:Class="MasterPlay.UI.Features.Scoring.InputScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EnterScore}" Height="230" Width="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource RateThisGame}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6">
            <TextBox Text="{Binding ScoreInput, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="32" Height="60"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Padding="12"
                     BorderThickness="0" Background="Transparent"
                     PreviewTextInput="NumberValidationTextBox" TextChanged="TextBox_TextChanged" Margin="-1,0,-1,0"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource IconButtonStyle}"
                    Background="#708A58"
                    Click="Ok_Click">
                <Image Source="/Assets/Save.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Style="{StaticResource IconButtonStyle}"
                    Margin="12,0,0,0"
                    Click="Cancel_Click">
                <Image Source="/Assets/Cancel.png" Width="20" Height="20" Margin="0,0,2.5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="MasterPlay.UI.Features.Settings.CatalogSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MasterPlay.UI.Converters"
             xmlns:dragDrop="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop">
    <UserControl.Resources><converters:Base64ImageConverter x:Key="Base64ImageConverter"/></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Button Command="{Binding BackCommand}" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" HorizontalAlignment="Left">
                <Image Source="/Assets/Back.png" Width="18" Height="18"/>
            </Button>
            <TextBlock Text="MANAGE ICONS" FontSize="18" FontWeight="Bold" Foreground="#A1BC98" VerticalAlignment="Center" Margin="48,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="180" HorizontalAlignment="Left" Height="32"/>
            <Button Command="{Binding AddCommand}" HorizontalAlignment="Right" Cursor="Hand" Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="border" Background="#A2D5C6" CornerRadius="15" Padding="12,5"><StackPanel Orientation="Horizontal"><Image Source="/Assets/Add.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Add" Foreground="White" FontWeight="SemiBold"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#82A066"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
        </Grid>
        <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
            <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" PreviewMouseWheel="Items_PreviewMouseWheel"
                     dragDrop:DragDrop.IsDragSource="True" dragDrop:DragDrop.IsDropTarget="True" dragDrop:DragDrop.DropHandler="{Binding}">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,10,10"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon, Converter={StaticResource Base64ImageConverter}}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="3" Command="{Binding DataContext.PasteIconCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="16,0,6,0" ToolTip="Paste icon"><Image Source="/Assets/Plus.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                        <Button Grid.Column="4" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" Background="#BFC9D1"><Image Source="/Assets/Close.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,15,0,0"><TextBlock Text="{Binding StatusMessage}" Foreground="#E74C3C" VerticalAlignment="Center"/><Button Command="{Binding SaveCommand}" Style="{StaticResource IconButtonStyle}" Background="#708A58" HorizontalAlignment="Right"><Image Source="/Assets/Save.png" Width="20" Height="20"/></Button></Grid>
    </Grid>
</UserControl>

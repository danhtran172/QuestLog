<Window x:Class="MasterPlay.UI.Features.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.Features.Settings"
        Title="{DynamicResource Settings}" Height="840" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="{DynamicResource ApplicationSettings}" FontSize="18" FontWeight="Bold" Foreground="#A1BC98" Margin="0,0,0,25"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberPath="NativeName"
                      Height="32"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource BackupRootPath}" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding BackupRootPath}" IsReadOnly="{Binding IsBackupReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditBackupCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>


        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource ConfigFilePath}" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ConfigPath}" IsReadOnly="{Binding IsConfigReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditConfigCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>


        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource DatabasePath}" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding DatabasePath}" IsReadOnly="{Binding IsDatabaseReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditDatabaseCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>


        <Grid Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource GameLibraryPaths}" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
            <Button Command="{Binding AddLibraryCommand}" HorizontalAlignment="Right" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#A2D5C6" CornerRadius="15" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Add.png" Width="16" Height="16" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{DynamicResource AddLibrary}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#82A066"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5F754B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>


        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
            <ItemsControl ItemsSource="{Binding LibraryPaths}" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>


                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A"
                                    Command="{Binding EditLibraryCommand}" Margin="10,0,5,0">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>


                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#BFC9D1"
                                    Command="{Binding DataContext.RemoveLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Padding="0">
                                <Image Source="/Assets/Close.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <TextBlock Grid.Row="7" Text="{Binding StatusMessage}" Foreground="#E74C3C" FontStyle="Italic" FontSize="12" Margin="0,15,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" Command="{Binding SaveCommand}">
                <Image Source="/Assets/Save.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CancelCommand}" Margin="12,0,0,0">
                <Image Source="/Assets/Close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>

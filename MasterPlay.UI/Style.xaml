<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:MasterPlay.UI.Converters">
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#A1BC98"/>
    <SolidColorBrush x:Key="MainTextBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#ECECEC"/>
    <SolidColorBrush x:Key="ItemSelectedBackground" Color="#D2E3FC"/>
    <!-- Converters -->
    <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
    <converters:BooleanInverseConverter x:Key="BoolInverse"/>
    <converters:SelectionColorConverter x:Key="SelectionColorConverter"/>
    <converters:MetaScoreColorConverter x:Key="MetaScoreColorConverter"/>
    <converters:LongTextFontSizeConverter x:Key="LongTextFontSizeConverter"/>
    <converters:StringToStringConverter x:Key="StringToStringConverter"/>
    <converters:SteamImageConverter x:Key="SteamImgConv"/>
    <!-- Field Label -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- Value Text Normal -->
    <Style x:Key="ValueTextStyleNormal" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <!-- Required Star -->
    <Style x:Key="RequiredStarStyle" TargetType="Run">
        <Setter Property="Foreground" Value="#E74C3C"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- Value Text -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <!-- N/A Text -->
    <Style x:Key="NAStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#BDC3C7"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Base TextBox -->
    <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Icon Button -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="circle" Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="circle" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Play Button -->
    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Background" Value="#A1BC98"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                <Setter Property="Background" Value="#FF8FB7"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Modern Search Box -->
    <Style x:Key="ModernSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="18" Background="{TemplateBinding Background}">
                        <Grid>
                            <Image Source="/Assets/Search.png" Width="14" Height="14" HorizontalAlignment="Left" Margin="12,0,0,0"
                                   Opacity="0.5" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="32,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPlaceholder" Text="Search..." Foreground="#999" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="35,0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="txtPlaceholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern Selection Box -->
    <Style x:Key="ModernSelectionBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontSize" Value="13"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Image x:Name="Icon"
                               Width="14"
                               Height="14"
                               Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               Source="{TemplateBinding Tag}"
                               Visibility="Collapsed"/>

                            <!-- Selected Text -->
                            <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            <!-- Arrow -->
                            <Path Grid.Column="2"
                              Data="M 0 0 L 5 5 L 10 0 Z"
                              Fill="#555"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Show icon only when Tag is set -->
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                        </Trigger>

                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ModernComboBoxStyle -->
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="White"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="0"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="25"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ICON (OPTIONAL) -->
                                            <Image x:Name="Icon"
                                               Grid.Column="0"
                                               Width="14"
                                               Height="14"
                                               Margin="10,0,6,0"
                                               VerticalAlignment="Center"
                                               Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- TEXT -->
                                            <ContentPresenter x:Name="Content"
                                                          Grid.Column="1"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                            <!-- ARROW -->
                                            <Path Grid.Column="2"
                                              Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                              Fill="#666"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- TRIGGERS -->
                                    <ControlTemplate.Triggers>
                                        <!-- NO ICON -->
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Content" Property="Grid.Column" Value="0"/>
                                            <Setter TargetName="Content" Property="Grid.ColumnSpan" Value="3"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- POPUP (GIỮ NGUYÊN) -->
                        <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                            <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,5,0,0"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer Margin="2">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Simple Selection Box -->
    <Style x:Key="SimpleSelectionBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,8,28,8"/>
        <!-- padding phải vừa đủ cho arrow -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="border"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Text hiển thị -->
                            <TextBlock x:Name="SelectedText"
                                   Text="{TemplateBinding SelectionBoxItem, Converter={StaticResource StringToStringConverter}}"
                                   Margin="10,0,32,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextAlignment="Left"/>
                            <!-- Arrow -->
                            <ToggleButton x:Name="ToggleButton"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                              Fill="#555555"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Width="10"
                                              Height="5"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Dropdown popup -->
                            <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               PopupAnimation="Slide"
                               Focusable="False">
                                <Border Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pagination -->
    <Style x:Key="PaginationSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <Style x:Key="PaginationPageInfoTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PaginationButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="BorderBrush" Value="#D9D9D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                            <Setter TargetName="border" Property="Background" Value="#F8FBF7"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#EEF5EC"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Base TextBox áp dụng mặc định -->
    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>
</ResourceDictionary>
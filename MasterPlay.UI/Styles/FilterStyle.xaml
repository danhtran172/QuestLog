<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="IsEditable" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsHitTestVisible="True"
                                          Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="4,0,0,0"/>
                                            <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0 Z"
                                                      Fill="#666"
                                                      Width="8"
                                                      Height="4"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                            <Border Background="White"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="200"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <ScrollViewer>
                                    <ItemsPresenter x:Name="ItemsPresenter"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#A1BC98"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>

                        <Image x:Name="FilterImage"
                                   Source="/Assets/Filter.png"
                                   Width="18"
                                   Height="18"
                                   Margin="0,2,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding DataContext.HasActiveFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="FilterImage" Property="Source" Value="/Assets/Filtering.png"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="FilterPopupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="FilterColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#2C3E50"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>


    <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#555555"/>
    </Style>


    <Style x:Key="FilterPopupStyle" TargetType="Popup">
        <Setter Property="Placement" Value="Center"/>
        <Setter Property="StaysOpen" Value="False"/>
        <Setter Property="PopupAnimation" Value="Slide"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Child">
            <Setter.Value>
                <Border Style="{StaticResource FilterPopupBorderStyle}" Width="700">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter" FontSize="18" FontWeight="SemiBold" Foreground="#A1BC98"/>
                            <CheckBox Grid.Column="1" Content="Reverse filter" Style="{StaticResource FilterCheckBoxStyle}" VerticalAlignment="Center"/>
                        </Grid>


                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Finish:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FilterComboBoxStyle}"
                                                  Margin="0,0,3,0"
                                                  SelectedIndex="0">
                                        <ComboBoxItem Content=">"/>
                                        <ComboBoxItem Content=">="/>
                                        <ComboBoxItem Content="="/>
                                        <ComboBoxItem Content="&lt;="/>
                                        <ComboBoxItem Content="&lt;"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="2"
                                                 Style="{StaticResource BaseTextBoxStyle}"
                                                 Height="28"
                                                 Padding="6,2"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Excited:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FilterComboBoxStyle}"
                                                  Margin="0,0,3,0"
                                                  SelectedIndex="0">
                                        <ComboBoxItem Content=">"/>
                                        <ComboBoxItem Content=">="/>
                                        <ComboBoxItem Content="="/>
                                        <ComboBoxItem Content="&lt;="/>
                                        <ComboBoxItem Content="&lt;"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="2"
                                                 Style="{StaticResource BaseTextBoxStyle}"
                                                 Height="28"
                                                 Padding="6,2"/>
                                </Grid>
                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Score:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FilterComboBoxStyle}"
                                                  Margin="0,0,3,0"
                                                  SelectedIndex="0">
                                        <ComboBoxItem Content=">"/>
                                        <ComboBoxItem Content=">="/>
                                        <ComboBoxItem Content="="/>
                                        <ComboBoxItem Content="&lt;="/>
                                        <ComboBoxItem Content="&lt;"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="2"
                                                 Style="{StaticResource BaseTextBoxStyle}"
                                                 Height="28"
                                                 Padding="6,2"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PlayTime:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FilterComboBoxStyle}"
                                                  Margin="0,0,3,0"
                                                  SelectedIndex="0">
                                        <ComboBoxItem Content=">"/>
                                        <ComboBoxItem Content=">="/>
                                        <ComboBoxItem Content="="/>
                                        <ComboBoxItem Content="&lt;="/>
                                        <ComboBoxItem Content="&lt;"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="2"
                                                 Style="{StaticResource BaseTextBoxStyle}"
                                                 Height="28"
                                                 Padding="6,2"/>
                                </Grid>
                            </StackPanel>
                        </Grid>


                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Avg Play" Style="{StaticResource FilterColumnHeaderStyle}"/>
                                <CheckBox Content="Very Long" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Long" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Medium" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Short" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Very Short" Style="{StaticResource FilterCheckBoxStyle}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Progress" Style="{StaticResource FilterColumnHeaderStyle}"/>
                                <CheckBox Content="NextPlay" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Done" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Playing" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Intended" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Pending" Style="{StaticResource FilterCheckBoxStyle}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="2" Margin="8,0">
                                <TextBlock Text="Ownership" Style="{StaticResource FilterColumnHeaderStyle}"/>
                                <CheckBox Content="Ready" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Painted" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="GamePass" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="PlayStation" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Not Owned" Style="{StaticResource FilterCheckBoxStyle}"/>
                            </StackPanel>


                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Text="MetaScore" Style="{StaticResource FilterColumnHeaderStyle}"/>
                                <CheckBox Content="Very High" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="High" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Medium" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Low" Style="{StaticResource FilterCheckBoxStyle}"/>
                                <CheckBox Content="Very Low" Style="{StaticResource FilterCheckBoxStyle}"/>
                            </StackPanel>
                        </Grid>


                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

                            <Button Content="Clear Filter" Width="100" Height="32" Style="{StaticResource PaginationButtonStyle}" Margin="0,0,8,0" Command="{Binding ClearFilterCommand}"/>


                            <Button Content="Apply" Width="100" Height="32" Style="{StaticResource PaginationButtonStyle}" Margin="0,0,8,0" Command="{Binding ApplyFilterCommand}"/>


                            <Button Width="32" Height="32" Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" ToolTip="Cancel">
                                <Image Source="/Assets/Back3.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
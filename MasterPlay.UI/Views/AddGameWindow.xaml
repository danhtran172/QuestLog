<Window x:Class="MasterPlay.UI.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="Add New Game" Height="680" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:AddGameViewModel />
    </Window.DataContext>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ADD NEW GAME" FontSize="18" FontWeight="Bold" Foreground="#A1BC98"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtStatus" Text="{Binding StatusMessage}"
                       Foreground="#E74C3C" FontStyle="Italic" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="250" TextAlignment="Right"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Game Name"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
                </TextBlock>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtGameName" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="10,0,0,0"
                            Background="#6FA4AF" Command="{Binding SyncCommand}">
                        <Image Source="/Assets/Clound Sync.png" Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Process Name"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
                </TextBlock>
                <TextBox x:Name="txtExeName" Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldLabelStyle}">
                    <Run Text="Save Location"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
                </TextBlock>
                <TextBox x:Name="txtSaveLocation" Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Cover Image URL" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="txtImagePath" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" Background="#F2F2F2"/>
                <StackPanel HorizontalAlignment="Right" Margin="0,0,0,10">
                    <TextBlock Text="Preview Cover" Style="{StaticResource FieldLabelStyle}"
                               FontSize="11" HorizontalAlignment="Right"/>
                    <Border x:Name="borderPreview"
                            BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5"
                            Width="200" Height="112" Background="#F9F9F9" Padding="2">
                        <Image x:Name="imgPreview"
                               Source="{Binding ImagePath}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Style="{StaticResource IconButtonStyle}" Background="#708A58"
                    Command="{Binding AddGameCommand}">
                <Image Source="/Assets/Save.png" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Margin="12,0,0,0"
                    Command="{Binding CancelCommand}">
                <Image Source="/Assets/Close.png" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="MasterPlay.UI.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        x:Name="ThisWindow"
        Title="Add New Game" Height="780" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:AddGameViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Height="400">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image Source="{Binding PreviewImage}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Border Background="#A0000000">
                <Grid Margin="30,0,30,30" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding GameName}"
                               FontSize="42"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxWidth="750">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MAIN CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,40">

                <!-- ==================== BASIC INFO ==================== -->
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20" Padding="15">
                    <StackPanel>
                        <!-- Game Name + Sync -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game Name" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="10,0,0,0"
                                    Background="#6FA4AF" Command="{Binding SyncCommand}"
                                    ToolTip="Sync Game Data">
                                <Image Source="/Assets/Clound Sync.png" Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>

                        <!-- Score -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Score" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="80" HorizontalContentAlignment="Center" 
                                         Text="{Binding Score, UpdateSourceTrigger=LostFocus}" 
                                         Height="28" Padding="8,4" 
                                         PreviewTextInput="Score_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- Play Time + Adjust -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Play Time" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <TextBox Width="60" HorizontalContentAlignment="Center" 
                                             Text="{Binding PlayTimeHours, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="8,4"/>
                                    <TextBlock Text="h" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,100,0">
                                    <TextBox Width="45" HorizontalContentAlignment="Center" 
                                             Text="{Binding PlayTimeMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="28" Padding="8,4"/>
                                    <TextBlock Text="m" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="0,0,4,0"
                                            Command="{Binding AdjustPlayTimeDownCommand}" ToolTip="Subtract minutes"
                                            Width="20" Height="20">
                                        <Image Source="/Assets/Minus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                    <TextBox Width="55" Text="{Binding AdjustMinutes, UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                                    <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="4,0,0,0"
                                            Command="{Binding AdjustPlayTimeUpCommand}" ToolTip="Add minutes"
                                            Width="20" Height="20">
                                        <Image Source="/Assets/Plus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== TWO COLUMN INFO ==================== -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <Border Grid.Column="0" Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <!-- Publish Date -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Published Date" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding PublishDateInput, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="8,4"/>
                            </Grid>

                            <!-- Publisher -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Publisher" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="8,4"/>
                            </Grid>

                            <!-- Developer -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Developer" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="28" Padding="8,4"/>
                            </Grid>

                            <!-- Series Chip -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Series" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                                <Button Grid.Column="1"
                                        x:Name="SeriesButton"
                                        Style="{StaticResource TagInputButtonStyle}"
                                        Command="{Binding OpenSeriesPopupCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <WrapPanel x:Name="SeriesWrapPanel">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSeries}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <Border Style="{StaticResource TagChipStyle}">
                                            <emoji:TextBlock Text="{Binding SelectedSeries.Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                        </Border>
                                    </WrapPanel>
                                </Button>

                                <!-- Popup chọn Series -->
                                <Popup x:Name="SeriesPopup"
                                       IsOpen="{Binding IsSeriesPopupOpen}"
                                       PlacementTarget="{Binding ElementName=SeriesButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Slide" Width="320">
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="0">
                                        <Grid MinHeight="300" MaxHeight="400">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Selected chip panel -->
                                            <WrapPanel Grid.Row="0" Margin="8,8,8,0" x:Name="SelectedSeriesPanel">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSeries}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <Border Style="{StaticResource TagChipStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <emoji:TextBlock Text="{Binding SelectedSeries.Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource TagRemoveButtonStyle}"
                                                                Command="{Binding RemoveSelectedSeriesCommand}"/>
                                                    </Grid>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Search box -->
                                            <TextBox Grid.Row="1" 
                                                     Text="{Binding SeriesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PopupSearchBoxStyle}"
                                                     Margin="8,8,8,0"/>

                                            <!-- List of series items -->
                                            <ScrollViewer Grid.Row="2" 
                                                          Margin="8,8,8,0" 
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredSeries}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Nội dung item -->
                                                                <Border Grid.Column="0" 
                                                                        Style="{StaticResource PopupItemStyle}" Width="120"
                                                                        MouseLeftButtonUp="SeriesItem_MouseLeftButtonUp" 
                                                                        Tag="{Binding}">
                                                                    <emoji:TextBlock Text="{Binding Name}" FontSize="13" Foreground="#2C3E50" FontFamily="Segoe UI Emoji"/>
                                                                </Border>
                                                                <!-- Nút More -->
                                                                <Button Grid.Column="1" 
                                                                        Style="{StaticResource IconButtonStyle}" 
                                                                        Background="Transparent" 
                                                                        BorderThickness="0"
                                                                        Width="20" Height="20"
                                                                        Margin="0"
                                                                        HorizontalAlignment="Right"
                                                                        Command="{Binding DataContext.OpenEditSeriesPopupCommand, ElementName=ThisWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Edit series">
                                                                    <Image Source="/Assets/More.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Create new item -->
                                            <Border Grid.Row="3" 
                                                    Style="{StaticResource PopupCreateNewStyle}"
                                                    Visibility="{Binding SeriesSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                    MouseLeftButtonUp="CreateNewSeries_MouseLeftButtonUp">
                                                <emoji:TextBlock Text="{Binding CreateNewSeriesText}" 
                                                           FontSize="13" 
                                                           Foreground="#FF88BA" 
                                                           Margin="10,0" 
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Genre Chip -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                                <Button Grid.Column="1"
                                        x:Name="GenresButton"
                                        Style="{StaticResource TagInputButtonStyle}"
                                        Command="{Binding OpenGenresPopupCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding SelectedGenres}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChipStyle}">
                                                    <emoji:TextBlock Text="{Binding Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Button>

                                <!-- Popup chọn Genre -->
                                <Popup x:Name="GenresPopup"
                                       IsOpen="{Binding IsGenresPopupOpen}"
                                       PlacementTarget="{Binding ElementName=GenresButton}"
                                       Placement="Bottom" StaysOpen="False" Width="320">
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="0">
                                        <Grid MinHeight="300" MaxHeight="400">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Selected chips panel -->
                                            <WrapPanel Grid.Row="0" Margin="8,8,8,0" x:Name="SelectedGenresPanel">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGenres.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <ItemsControl ItemsSource="{Binding SelectedGenres}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource TagChipStyle}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <emoji:TextBlock Text="{Binding Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource TagRemoveButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>

                                            <!-- Search box -->
                                            <TextBox Grid.Row="1" 
                                                     Text="{Binding GenresSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PopupSearchBoxStyle}"
                                                     Margin="8,8,8,0"/>

                                            <!-- List of genre items -->
                                            <ScrollViewer Grid.Row="2" 
                                                          Margin="8,8,8,0" 
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredGenres}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Nội dung item -->
                                                                <Border Grid.Column="0" 
                                                                        Style="{StaticResource PopupItemStyle}" Width="120"
                                                                        MouseLeftButtonUp="GenreItem_MouseLeftButtonUp" 
                                                                        Tag="{Binding}">
                                                                    <emoji:TextBlock Text="{Binding Name}" Style="{StaticResource EmojiTextStyle}" FontFamily="Segoe UI Emoji"/>
                                                                </Border>
                                                                <!-- Nút More -->
                                                                <Button Grid.Column="1" 
                                                                        Style="{StaticResource IconButtonStyle}" 
                                                                        Background="Transparent" 
                                                                        BorderThickness="0"
                                                                        Width="20" Height="20"
                                                                        Margin="0"
                                                                        HorizontalAlignment="Right"
                                                                        Command="{Binding DataContext.OpenEditGenrePopupCommand, ElementName=ThisWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Edit genre">
                                                                    <Image Source="/Assets/More.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Create new item -->
                                            <Border Grid.Row="3" 
                                                    Style="{StaticResource PopupCreateNewStyle}"
                                                    Visibility="{Binding GenresSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                    MouseLeftButtonUp="CreateNewGenre_MouseLeftButtonUp">
                                                <emoji:TextBlock Text="{Binding CreateNewGenreText}" 
                                                           FontSize="13" 
                                                           Foreground="#FF88BA" 
                                                           Margin="10,0" 
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Theme Chip -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top"/>

                                <Button Grid.Column="1"
                                        x:Name="ThemesButton"
                                        Style="{StaticResource TagInputButtonStyle}"
                                        Command="{Binding OpenThemesPopupCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding SelectedThemes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChipStyle}">
                                                    <emoji:TextBlock Text="{Binding Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Button>

                                <!-- Popup chọn Theme -->
                                <Popup x:Name="ThemesPopup"
                                       IsOpen="{Binding IsThemesPopupOpen}"
                                       PlacementTarget="{Binding ElementName=ThemesButton}"
                                       Placement="Bottom" StaysOpen="False" Width="320">
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="0">
                                        <Grid MinHeight="300" MaxHeight="400">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Selected chips panel -->
                                            <WrapPanel Grid.Row="0" Margin="8,8,8,0" x:Name="SelectedThemesPanel">
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedThemes.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <ItemsControl ItemsSource="{Binding SelectedThemes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource TagChipStyle}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <emoji:TextBlock Text="{Binding Name}" Foreground="#2C3E50" FontSize="13" FontFamily="Segoe UI Emoji"/>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource TagRemoveButtonStyle}"
                                                                            Command="{Binding DataContext.RemoveThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>

                                            <!-- Search box -->
                                            <TextBox Grid.Row="1" 
                                                     Text="{Binding ThemesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PopupSearchBoxStyle}"
                                                     Margin="8,8,8,0"/>

                                            <!-- List of theme items -->
                                            <ScrollViewer Grid.Row="2" 
                                                          Margin="8,8,8,0" 
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredThemes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Nội dung item -->
                                                                <Border Grid.Column="0" 
                                                                        Style="{StaticResource PopupItemStyle}" Width="120"
                                                                        MouseLeftButtonUp="ThemeItem_MouseLeftButtonUp" 
                                                                        Tag="{Binding}">
                                                                    <emoji:TextBlock Text="{Binding Name}" Style="{StaticResource EmojiTextStyle}" FontFamily="Segoe UI Emoji"/>
                                                                </Border>
                                                                <!-- Nút More -->
                                                                <Button Grid.Column="1" 
                                                                        Style="{StaticResource IconButtonStyle}" 
                                                                        Background="Transparent" 
                                                                        BorderThickness="0"
                                                                        Width="20" Height="20"
                                                                        Margin="0"
                                                                        HorizontalAlignment="Right"
                                                                        Command="{Binding DataContext.OpenEditThemePopupCommand, ElementName=ThisWindow}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Edit theme">
                                                                    <Image Source="/Assets/More.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Create new item -->
                                            <Border Grid.Row="3" 
                                                    Style="{StaticResource PopupCreateNewStyle}"
                                                    Visibility="{Binding ThemesSearchText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                    MouseLeftButtonUp="CreateNewTheme_MouseLeftButtonUp">
                                                <emoji:TextBlock Text="{Binding CreateNewThemeText}" 
                                                           FontSize="13" 
                                                           Foreground="#FF88BA" 
                                                           Margin="10,0" 
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT COLUMN -->
                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Border.Resources>
                            <!-- Style dành cho Ownership -->
                            <Style x:Key="ChipComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource SimpleSelectionBoxStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border CornerRadius="4"
                                                    Padding="8,2"
                                                    Background="{Binding Converter={StaticResource SelectionGlassColorConverter}, ConverterParameter=Ownership}"
                                                    HorizontalAlignment="Center"
                                                    Margin="2">
                                                <emoji:TextBlock Text="{Binding Name}" 
                                                           Foreground="#2C3E50" 
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji"/>
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Border x:Name="border"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Border x:Name="SelectedChip"
                                                            CornerRadius="4"
                                                            Padding="8,2"
                                                            Background="{Binding SelectedItem, Converter={StaticResource SelectionGlassColorConverter}, ConverterParameter=Ownership, RelativeSource={RelativeSource TemplatedParent}}"
                                                            HorizontalAlignment="Left"
                                                            Margin="2"
                                                            Visibility="{Binding SelectedItem, Converter={StaticResource StringToStringConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                                                            IsHitTestVisible="False">
                                                        <emoji:TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                   Foreground="#2C3E50" 
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Emoji"/>
                                                    </Border>
                                                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#555555"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Width="10"
                                                          Height="5"
                                                          Opacity="0.8"
                                                          IsHitTestVisible="False"/>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"
                                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Focusable="False">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Popup x:Name="Popup"
                                                           Placement="Bottom"
                                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Slide"
                                                           Focusable="False">
                                                        <Border Background="White"
                                                                BorderBrush="#DDDDDD"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Margin="0,2,0,0"
                                                                MinWidth="{TemplateBinding ActualWidth}">
                                                            <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                                                <ItemsPresenter SnapsToDevicePixels="True"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                                    <Setter TargetName="SelectedChip" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Style dành cho Progress -->
                            <Style x:Key="ChipComboBoxStyleProgress" TargetType="ComboBox" BasedOn="{StaticResource SimpleSelectionBoxStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="ItemTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border CornerRadius="4"
                                                    Padding="8,2"
                                                    Background="{Binding Converter={StaticResource SelectionGlassColorConverter}, ConverterParameter=Progress}"
                                                    HorizontalAlignment="Center"
                                                    Margin="2">
                                                <emoji:TextBlock Text="{Binding Name}" 
                                                           Foreground="#2C3E50" 
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Emoji"/>
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Border x:Name="border"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Border x:Name="SelectedChip"
                                                            CornerRadius="4"
                                                            Padding="8,2"
                                                            Background="{Binding SelectedItem, Converter={StaticResource SelectionGlassColorConverter}, ConverterParameter=Progress, RelativeSource={RelativeSource TemplatedParent}}"
                                                            HorizontalAlignment="Left"
                                                            Margin="2"
                                                            Visibility="{Binding SelectedItem, Converter={StaticResource StringToStringConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                                                            IsHitTestVisible="False">
                                                        <emoji:TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                   Foreground="#2C3E50" 
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Emoji"/>
                                                    </Border>
                                                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#555555"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Width="10"
                                                          Height="5"
                                                          Opacity="0.8"
                                                          IsHitTestVisible="False"/>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"
                                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Focusable="False">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent"/>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Popup x:Name="Popup"
                                                           Placement="Bottom"
                                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Slide"
                                                           Focusable="False">
                                                        <Border Background="White"
                                                                BorderBrush="#DDDDDD"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Margin="0,2,0,0"
                                                                MinWidth="{TemplateBinding ActualWidth}">
                                                            <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                                                <ItemsPresenter SnapsToDevicePixels="True"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                                    <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                                    <Setter TargetName="SelectedChip" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>

                        <StackPanel>
                            <!-- MetaScore -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MetaScore" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Style="{StaticResource IconButtonStyle}" 
                                            Command="{Binding CheckMetaScoreCommand}" 
                                            ToolTip="Check MetaScore"
                                            Width="12" 
                                            Height="12" 
                                            Margin="2,-2,0,0" 
                                            VerticalAlignment="Top"
                                            Visibility="{Binding HasSlugName, Converter={StaticResource BoolToVis}}">
                                        <Image Source="/Assets/Question.png" 
                                               Width="12" 
                                               Height="12" 
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding MetaScore, UpdateSourceTrigger=PropertyChanged}" 
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                            </Grid>

                            <!-- AvgPlaytime -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Avg Playtime" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Style="{StaticResource IconButtonStyle}" 
                                            Command="{Binding CheckPlayTimeCommand}" 
                                            ToolTip="Check Playtime"
                                            Width="12" 
                                            Height="12" 
                                            Margin="2,-2,0,0" 
                                            VerticalAlignment="Top">
                                        <Image Source="/Assets/Question.png" 
                                               Width="12" 
                                               Height="12" 
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding AvgPlaytime, UpdateSourceTrigger=PropertyChanged}" 
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                            </Grid>

                            <!-- Excited -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Excited" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Excited, UpdateSourceTrigger=LostFocus}" 
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4" PreviewTextInput="Score_PreviewTextInput"/>
                            </Grid>

                            <!-- Ownership -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ownership" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AllOwnerships}"
                                          SelectedItem="{Binding SelectedOwnership}"
                                          Style="{StaticResource ChipComboBoxStyle}"
                                          Height="28"/>
                            </Grid>

                            <!-- Progress -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Progress" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AllProgresses}"
                                          SelectedItem="{Binding SelectedProgress}"
                                          Style="{StaticResource ChipComboBoxStyleProgress}"
                                          Height="28"/>
                            </Grid>

                            <!-- FinishedIn -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Finished In" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding FinishedIn, UpdateSourceTrigger=PropertyChanged}" 
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4" PreviewTextInput="FinishedIn_PreviewTextInput"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== PROCESS & FOLDERS SECTION ==================== -->
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <!-- Process Name + Has launch process checkbox -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process Name" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="2" Content="Has launch process" IsChecked="{Binding HasInitExeName}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Launch Process (visible when HasInitExeName) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding HasInitExeName, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Launch Game Process" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding InitExeName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                        </Grid>

                        <!-- Save Location -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Save Location" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SaveFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                    Command="{Binding EditSaveFolderCommand}">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>

                        <!-- Backup Folder -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Backup Folder" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding BackupFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                    Command="{Binding EditBackupFolderCommand}">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>

                        <!-- Cover Image URL + Sync -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cover Image URL" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#6FA4AF"
                                    Margin="15,0,0,0"
                                    Command="{Binding SyncImageCommand}"
                                    ToolTip="Refresh preview image">
                                <Image Source="/Assets/Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>

                        <!-- Gallery Image URL + Sync -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gallery Image URL" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding GImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#6FA4AF"
                                    Margin="15,0,0,0"
                                    Command="{Binding SyncImageCommand}"
                                    ToolTip="Refresh gallery preview image">
                                <Image Source="/Assets/Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>

                        <!-- Gallery Preview -->
                        <Grid>
                            <Border Width="460" Height="215" HorizontalAlignment="Center"
                                    SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.14"/>
                                </Border.Effect>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding GImagePath, Converter={StaticResource SteamImgConv}}"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" 
                Padding="20,15" 
                BorderBrush="#F5F5F5" 
                BorderThickness="0,1,0,0" 
                Background="#FAFAFA">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  Direction="315" 
                                  ShadowDepth="3" 
                                  BlurRadius="8" 
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#E74C3C" 
                           FontStyle="Italic" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="50,0,0,0"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#708A58"
                            Command="{Binding AddGameCommand}">
                        <Image Source="/Assets/Save.png" 
                               Width="20" 
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="12,0,0,0"
                            Command="{Binding CancelCommand}">
                        <Image Source="/Assets/Close.png" 
                               Width="20" 
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== EDIT POPUPS ==================== -->
        <!-- Edit Series Popup -->
        <Popup x:Name="EditSeriesPopup"
               IsOpen="{Binding IsEditSeriesPopupOpen}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Series" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditSeriesName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" 
                                Command="{Binding SaveSeriesEditCommand}" ToolTip="Save">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteSeriesCommand}" ToolTip="Delete">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditSeriesCommand}" ToolTip="Cancel">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Edit Genre Popup -->
        <Popup x:Name="EditGenrePopup"
               IsOpen="{Binding IsEditGenrePopupOpen}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Genre" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditGenreName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" 
                                Command="{Binding SaveGenreEditCommand}" ToolTip="Save">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteGenreCommand}" ToolTip="Delete">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditGenreCommand}" ToolTip="Cancel">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Edit Theme Popup -->
        <Popup x:Name="EditThemePopup"
               IsOpen="{Binding IsEditThemePopupOpen}"
               Placement="Center"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide">
            <Border Width="300" Padding="20"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Theme" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <TextBox Text="{Binding EditThemeName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" Padding="8,4" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" 
                                Command="{Binding SaveThemeEditCommand}" ToolTip="Save">
                            <Image Source="/Assets/Save.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" Margin="10,0,0,0"
                                Command="{Binding DeleteThemeCommand}" ToolTip="Delete">
                            <Image Source="/Assets/Delete.png" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0"
                                Command="{Binding CancelEditThemeCommand}" ToolTip="Cancel">
                            <Image Source="/Assets/Close.png" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
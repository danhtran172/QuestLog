<Window x:Class="MasterPlay.UI.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="Add New Game" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style cho nhãn trường thông tin -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Style cho dấu * bắt buộc -->
        <Style x:Key="RequiredStarStyle" TargetType="Run">
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Style cho TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A1BC98"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:AddGameViewModel />
    </Window.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="ADD NEW GAME"
                   FontSize="18" FontWeight="Bold" Foreground="#A1BC98"
                   Margin="0,0,0,25"/>

        <!-- Các trường nhập liệu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,15">
                <Run Text="Game Name"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
            </TextBlock>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtGameName"
                         Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Nút Sync-->
                <Button Grid.Column="1" x:Name="btnSync"
                        Style="{StaticResource IconButtonStyle}"
                        Margin="10,0,0,0"
                        Background="#6FA4AF"
                        Command="{Binding SyncCommand}"
                        ToolTip="Sync Game Data">
                    <Image Source="/Assets/Clound Sync.png"
                           Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>

            <!-- Process Name -->
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,15">
                <Run Text="Process Name"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
            </TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtExeName" 
                     Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15"/>

            <!-- Save Location -->
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,15">
                <Run Text="Save Location"/> <Run Text="*" Style="{StaticResource RequiredStarStyle}"/>
            </TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSaveLocation" 
                     Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,15"/>

            <!-- Cover Image URL -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cover Image URL"
                       Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,15"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtImagePath"
                     Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True" Margin="0,0,0,15"/>
        </Grid>

        <!-- Preview & Status -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border x:Name="borderPreview"
                    BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="8"
                    Background="#FAFAFA" Padding="8"
                    HorizontalAlignment="Left" Width="240" Height="120"
                    Visibility="Collapsed">
                <Image x:Name="imgPreview" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="txtStatus" Foreground="#E74C3C"
                       Text="{Binding StatusMessage}"
                       FontStyle="Italic" FontSize="12" 
                       Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer: Cancel (trái) - Confirm Add (phải) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <!-- Nút Confirm Add -->
            <Button Grid.Column="1" x:Name="btnCancel"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="10,0,0,0"
                    Background="#708A58"
                    Command="{Binding AddGameCommand}"
                    ToolTip="Add new Game">
                <Image Source="/Assets/Save.png"
                       Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <!-- Nút Cancel -->
            <Button Grid.Column="1" x:Name="btnAdd"
                    Style="{StaticResource IconButtonStyle}"
                    Margin="10,0,0,0"
                    Command="{Binding CancelCommand}"
                    ToolTip="Cancel">
                <Image Source="/Assets/Close.png"
                       Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
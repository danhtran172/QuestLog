<Window x:Class="MasterPlay.UI.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="Add New Game" Height="780" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:AddGameViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Height="400">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image Source="{Binding PreviewImage}"
           Stretch="UniformToFill"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>

            <Border Background="#A0000000">
                <Grid Margin="30,0,30,30" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding GameName}"
                       FontSize="42"
                       FontWeight="ExtraBold"
                       Foreground="White"
                       TextWrapping="Wrap"
                       MaxWidth="750">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <!-- ==================== MAIN CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,40">
                <!-- ==================== ADD ==================== -->
                <!-- Khung Basic -->
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20" Padding="8">
                    <StackPanel>
                        <!-- Hàng 1: Game Name -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game Name" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="10,0,0,0"
                                    Background="#6FA4AF" Command="{Binding SyncCommand}"
                                    ToolTip="Sync Game Data">
                                <Image Source="/Assets/Clound Sync.png" Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Khung 1 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <!-- Published Date -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Published Date" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding PublishDateInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd}}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Publisher -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Publisher" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Developer -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Developer" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Series -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Series" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Series, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Genre -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Theme -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Theme, UpdateSourceTrigger=PropertyChanged}"
                                         Height="28" Padding="8,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Khung 2 -->
                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <!-- MetaScore -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MetaScore" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding MetaScore, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Avg Playtime -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Avg Playtime" Style="{StaticResource FieldLabelStyle}"/>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding CheckPlayTimeCommand}"
                                            ToolTip="Check Playtime"
                                            Width="12"
                                            Height="12"
                                            Margin="2,-2,0,0"
                                            VerticalAlignment="Top">
                                        <Image Source="/Assets/Question.png"
                                               Width="12"
                                               Height="12"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding AvgPlaytime, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Excited -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Excited" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Excited, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center" Height="28" Padding="8,4" PreviewTextInput="Score_PreviewTextInput"/>
                            </Grid>
                            <!-- Ownership -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ownership" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Selections.Ownership}"
                                          SelectedItem="{Binding Ownership}"
                                          Style="{StaticResource SimpleSelectionBoxStyle}"
                                          Height="28"
                                          ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}"/>
                            </Grid>
                            <!-- Progress -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Progress" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Selections.Progress}"
                                          SelectedItem="{Binding Progress}"
                                          Style="{StaticResource SimpleSelectionBoxStyle}"
                                          Height="28"
                                          ItemContainerStyle="{StaticResource {x:Type ComboBoxItem}}"/>
                            </Grid>
                            
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Khung 3 -->
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <!-- Process Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding ExeName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                        </Grid>
                        <!-- Start Game Process Name -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start Game Process" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding InitExeName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                        </Grid>
                        <!-- Save Location -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Save Location" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                    Command="{Binding EditSaveFolderCommand}">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>
                        <!-- Backup Folder -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Backup Folder" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding BackupFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                    Command="{Binding EditBackupFolderCommand}">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>
                        <!-- Cover Image URL -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cover Image URL" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="#6FA4AF"
                                    Margin="15,0,0,0"
                                    Command="{Binding SyncImageCommand}"
                                    ToolTip="Refresh preview image">
                                <Image Source="/Assets/Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Padding="20,15" BorderBrush="#F5F5F5" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E74C3C" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="50,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" Command="{Binding AddGameCommand}">
                        <Image Source="/Assets/Save.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="12,0,0,0" Command="{Binding CancelCommand}">
                        <Image Source="/Assets/Close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
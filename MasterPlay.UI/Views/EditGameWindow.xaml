<Window x:Class="MasterPlay.UI.EditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="Game Details" Height="780" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:EditGameViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="280"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0">
            <Image Source="{Binding PreviewImage}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
            <Border Background="#A0000000">
                <Grid Margin="30,0,30,30" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Game.Name}"
                               FontSize="42"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxWidth="750">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>
            <Button Style="{StaticResource IconButtonStyle}"
                    Background="#3291B6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="25"
                    Command="{Binding ToggleEditModeCommand}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                <Image Source="/Assets/Edit.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>

        <!-- ==================== MAIN CONTENT ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,40">

                <!-- ==================== VIEW MODE ==================== -->
                <StackPanel Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">

                    <!-- [View Mode] Khung Basic -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Score" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DisplayScore}"
                                       FontSize="18"
                                       FontWeight="Normal"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Playtime" 
                   Style="{StaticResource FieldLabelStyle}" 
                   />
                          
                            <TextBlock Text="{Binding DisplayPlayTime}"
                   Style="{StaticResource ValueTextStyleNormal}"
                   Margin="8,0,8,0"
                   FontSize="13"
                   FontWeight="Normal"
                   Foreground="#2C3E50"
                   VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Background="#DDAED3"
                                    Width="36" Height="36"
                                    Command="{Binding FinishGameCommand}"
                                    ToolTip="Mark as Finished">
                                
                                <Image Source="/Assets/Finish.png" Width="20" Height="20" Margin="0,2,2,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Two-column info panels -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- [View Mode] Khung 1 -->
                        <Border Grid.Column="0"
                                Background="#F9F9F9"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,10,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- Publish Date -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Published Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishDate}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Publisher -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Publisher" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Developer -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Developer" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayDeveloper}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Series -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Series" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplaySeries}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Genre -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayGenre}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Theme -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTheme}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- [View Mode] Khung 2 -->
                        <Border Grid.Column="1"
                                Background="#F9F9F9"
                                CornerRadius="8"
                                Padding="15"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel>
                                <!-- MetaScore -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MetaScore" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayMetaScore}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Excited -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Excited" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>

                                <!-- Ownership -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ownership" Style="{StaticResource FieldLabelStyle}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding Game.Ownership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}"
                                            CornerRadius="4" Padding="8">
                                        <TextBlock Text="{Binding DisplayOwnership}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Play Progress -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Play Progress" Style="{StaticResource FieldLabelStyle}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding Game.Progress, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Progress}"
                                            CornerRadius="4" Padding="8">
                                        <TextBlock Text="{Binding DisplayProgress}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <!-- Avg Playtime -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Avg Playtime" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayAvgPlayTime}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                                <!-- Finish Year -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Finished In" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayFinishedIn}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- [View Mode] Khung 3 -->
                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <!-- ProcessName -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Process Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayProcessName}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13"/>
                            </Grid>
                            <!-- Save Location -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Save Location" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplaySaveFolderPath}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding OpenSaveFolderCommand}"
                                        IsEnabled="{Binding SaveFolderAccessible}"
                                        Opacity="{Binding SaveFolderAccessible, Converter={StaticResource BoolToOpacity}}">
                                    <Image Source="/Assets/OpenFolder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                            <!-- Backup Folder -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Backup Folder" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayBackupFolderPath}" Style="{StaticResource ValueTextStyle}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                                        Command="{Binding OpenBackupFolderCommand}"
                                        IsEnabled="{Binding BackupFolderAccessible}"
                                        Opacity="{Binding BackupFolderAccessible, Converter={StaticResource BoolToOpacity}}">
                                    <Image Source="/Assets/OpenFolder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== EDIT MODE ==================== -->
                <StackPanel Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}">

                    <!-- [Edit Mode] Khung Basic -->
                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20" Padding="15">
                        <StackPanel>
                            <!-- Game Name -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game Name" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Game.Name, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="10,0,0,0"
                                        Background="#6FA4AF" Command="{Binding SyncCommand}"
                                        ToolTip="Sync Game Data">
                                    <Image Source="/Assets/Clound Sync.png" Width="18" Height="18"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                            <!-- PlayTime -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Play Time" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBox Width="60" HorizontalContentAlignment="Center" Text="{Binding PlayTimeHours, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                        <TextBlock Text="h" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,100,0">
                                        <TextBox Width="45" HorizontalContentAlignment="Center" Text="{Binding PlayTimeMinutes, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                        <TextBlock Text="m" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="0,0,4,0"
                                Command="{Binding AdjustPlayTimeDownCommand}" ToolTip="Subtract minutes"
                                Width="20" Height="20">
                                            <Image Source="/Assets/Minus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                        <TextBox Width="55" Text="{Binding AdjustMinutes, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                                        <Button Style="{StaticResource IconButtonStyle}" Background="#F0EEED" Margin="4,0,0,0"
                                Command="{Binding AdjustPlayTimeUpCommand}" ToolTip="Add minutes"
                                Width="20" Height="20">
                                            <Image Source="/Assets/Plus.png" Width="10" Height="10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- [Edit Mode] Khung 1 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        
                        <Border Grid.Column="0" Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <!-- Publish Date -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Published Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.PublishDate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd}}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Publisher -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Publisher" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Publisher, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Developer -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Developer" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Developer, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Series -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Series" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Series, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Genre -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Genre, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Theme-->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Theme, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="8,4"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- [Edit Mode] Khung 2 -->
                        <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel>
                                <!-- MetaScore -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MetaScore" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.MetaScore, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Excited -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Excited" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.Excited, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" Height="28" Padding="8,4" PreviewTextInput="Excited_PreviewTextInput"/>
                                </Grid>
                                <!-- Ownership -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ownership" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Selections.Ownership}"
                                          SelectedItem="{Binding Game.Ownership}"
                                          Style="{StaticResource SimpleSelectionBoxStyle}"
                                          Height="28"/>
                                </Grid>

                                <!-- Progress -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Progress" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Selections.Progress}"
                                          SelectedItem="{Binding Game.Progress}"
                                          Style="{StaticResource SimpleSelectionBoxStyle}"
                                          Height="28"/>
                                </Grid>
                                <!-- Avg Runtime -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Avg Playtime" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AvgPlaytime, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" Height="28" Padding="8,4"/>
                                </Grid>
                                <!-- Finished Year -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Finished In" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Game.FinishedIn, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" Height="28" Padding="8,4" PreviewTextInput="FinishedIn_PreviewTextInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- [Edit Mode] Khung 3 -->                   
                    <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <!-- Process Name -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Process Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Game.ExeName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                            </Grid>
                            <!-- Save Location -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Save Location" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Game.SaveFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                        Command="{Binding EditSaveFolderCommand}" IsEnabled="{Binding SaveFolderAccessible}">
                                    <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                            <!-- Backup Folder -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Backup Folder" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Game.BackupFolderPath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Margin="15,0,0,0"
                        Command="{Binding EditBackupFolderCommand}" IsEnabled="{Binding BackupFolderAccessible}">
                                    <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                            <!-- Image Path -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cover Image URL" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Game.ImagePath, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,4"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButtonStyle}"
                                        Background="#6FA4AF"
                                        Margin="15,0,0,0"
                                        Command="{Binding SyncImageCommand}"
                                        ToolTip="Refresh preview image">
                                    <Image Source="/Assets/Sync.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Padding="20,15" BorderBrush="#F5F5F5" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E74C3C" FontStyle="Italic" FontSize="11" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButtonStyle}" Background="#A94A4A" HorizontalAlignment="Left"
                        Command="{Binding DeleteGameCommand}" ToolTip="Disable Game"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}">
                    <Image Source="/Assets/Delete.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVis}}">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Background="#708A58"
                                Command="{Binding SaveCommand}">
                            <Image Source="/Assets/Save.png" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="12,0,0,0"
                                Command="{Binding CancelCommand}">
                            <Image Source="/Assets/Cancel.png" Width="20" Height="20"
                                   Margin="0,0,2.5,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Margin="12,0,0,0"
                            Command="{Binding CloseCommand}"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                        <Image Source="/Assets/Close.png" Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
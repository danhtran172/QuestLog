<Window x:Class="MasterPlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="MasterPlay" Height="700" Width="920" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ==================== INPUT BINDINGS ==================== -->
    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding ToggleSettingsCommand}" />
    </Window.InputBindings>

    <!-- ==================== ROOT ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="25,12">
                <Image Source="/Assets/MasterplayLogo.png"
                       HorizontalAlignment="Left"
                       Width="140"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="250" Height="40" Background="Transparent" CornerRadius="20">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource ModernSearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="SearchBox_TextChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,100,0"
                                     Margin="0"/>

                            <Border HorizontalAlignment="Right" Width="94" Height="40" Margin="0,0,1.5,0" Background="Transparent">
                                <ComboBox x:Name="SearchByComboBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="0"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          VerticalContentAlignment="Center"
                                          HorizontalContentAlignment="Center"
                                          Padding="0"
                                          SelectionChanged="SearchByComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Series"/>
                                    <ComboBoxItem Content="Publisher"/>
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Release"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </Border>

                    <ComboBox x:Name="ViewModeComboBox"
                              Width="100"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="ViewModeComboBox_SelectionChanged"
                              Tag="/Assets/ViewMode2.png"
                              SelectedIndex="0"
                              Margin="10,0,10,0">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Plan"/>
                        <ComboBoxItem Content="Finish"/>
                    </ComboBox>

                    <ComboBox x:Name="SortComboBox"
                              Width="115"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="SortComboBox_SelectionChanged"
                              Tag="/Assets/Sort.png"
                              SelectedIndex="0"
                              Margin="0,0,20,0">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Status"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Playtime"/>
                        <ComboBoxItem Content="Publish"/>
                        <ComboBoxItem Content="MetaScore"/>
                        <ComboBoxItem Content="Excited"/>
                        <ComboBoxItem Content="Score"/>
                        <ComboBoxItem Content="Ownership"/>
                        <ComboBoxItem Content="Progress"/>
                        <ComboBoxItem Content="AvgPlaytime"/>
                    </ComboBox>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#A1BC98"
                            Click="AddGameButton_Click">
                        <Image Source="/Assets/Add.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#7F8C8D"
                            Margin="10,0,0,0"
                            Click="SettingsButton_Click">
                        <Image Source="/Assets/Setting.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GALLERY ==================== -->
        <ScrollViewer x:Name="GamesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="5">

            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Border Width="270"
                                Margin="6"
                                Background="White"
                                BorderBrush="#E4E4E4"
                                BorderThickness="1"
                                CornerRadius="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ==================== CARD IMAGE ==================== -->
                                <Border Grid.Row="0"
                                        Height="126.2"
                                        CornerRadius="14,14,0,0"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Game.GImagePath, Converter={StaticResource SteamImgConv}}"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border.Background>
                                </Border>

                                <!-- ==================== CARD CONTENT ==================== -->
                                <Grid Grid.Row="1" Margin="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Title -->
                                        <RowDefinition Height="*"/>
                                        <!-- Spacer -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Mode content (All/Plan/Finish) -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Card footer -->
                                    </Grid.RowDefinitions>

                                    <!-- ==================== TITLE ==================== -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,15"/>

                                    <!-- ==================== MODE CONTENT ==================== -->
                                    <Grid Grid.Row="2">

                                        <!-- ========== ALL MODE ========== -->
                                        <StackPanel Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                            <!-- Published + MetaScore -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Published:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPublishYear}"
                                                           FontSize="12"/>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="MetaScore: "
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                            CornerRadius="4"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayMetaScore}"
                                                                   Foreground="#2C3E50"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"
                                                                   Padding="2,0"
                                                                   Background="Transparent"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Publisher -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Publisher:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPublisher}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Playtime -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Playtime:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPlayTime}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- ===== ADDITIONAL INFO ===== (chèn vào giữa, margin 10) -->
                                            <!-- Series -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Series:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Series}" FontSize="12"/>
                                            </Grid>

                                            <!-- Developer -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Developer:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Developer}" FontSize="12"/>
                                            </Grid>

                                            <!-- Publisher bổ sung -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Publisher:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12"/>
                                            </Grid>

                                            <!-- Playtime bổ sung -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Playtime:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12"/>
                                            </Grid>

                                            <!-- Excited -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Excited:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" FontSize="12"/>
                                            </Grid>

                                            <!-- Score -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Score:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayScore}" FontSize="12"/>
                                            </Grid>

                                            <!-- Ownership -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ownership:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayOwnership}" FontSize="12"/>
                                            </Grid>

                                            <!-- AvgPlaytime (khi sort theo avg playtime) -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Avg Play:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayAvgPlayTime}" FontSize="12"/>
                                            </Grid>

                                            <!-- Progress (giữ nguyên margin 16) -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Progress:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayProgress}"
                                                           FontSize="12"/>
                                            </Grid>

                                        </StackPanel>

                                        <!-- ========== PLAN MODE ========== -->
                                        <StackPanel Visibility="{Binding DataContext.IsPlanMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                            <!-- Published + MetaScore -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Published:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPublishYear}"
                                                           FontSize="12"/>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="MetaScore: "
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                            CornerRadius="4"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayMetaScore}"
                                                                   Foreground="#2C3E50"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"
                                                                   Padding="2,0"
                                                                   Background="Transparent"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Excited -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Excited:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayExcited}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Avg Playtime -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Avg Play:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayAvgPlayTime}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Ownership -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Ownership:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayOwnership}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- ===== ADDITIONAL INFO ===== (chèn vào giữa, margin 10) -->
                                            <!-- Series -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Series:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Series}" FontSize="12"/>
                                            </Grid>

                                            <!-- Developer -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Developer:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Developer}" FontSize="12"/>
                                            </Grid>

                                            <!-- Publisher -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Publisher:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12"/>
                                            </Grid>

                                            <!-- Playtime -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Playtime:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12"/>
                                            </Grid>

                                            <!-- Score -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Score:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayScore}" FontSize="12"/>
                                            </Grid>

                                            <!-- AvgPlaytime (khi sort theo avg playtime) - nếu cần hiện thêm (nhưng trong Plan đã có sẵn, nên có thể ẩn) -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Avg Play:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayAvgPlayTime}" FontSize="12"/>
                                            </Grid>

                                            <!-- Progress (giữ nguyên margin 16) -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Progress:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayProgress}"
                                                           FontSize="12"/>
                                            </Grid>

                                        </StackPanel>

                                        <!-- ========== FINISH MODE ========== -->
                                        <StackPanel Visibility="{Binding DataContext.IsFinishMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                            <!-- Score + MetaScore -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Score:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayScore}"
                                                           FontSize="12"/>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="MetaScore: "
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                            CornerRadius="4"
                                                            Padding="4,1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayMetaScore}"
                                                                   Foreground="#2C3E50"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left"
                                                                   Padding="2,0"
                                                                   Background="Transparent"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Finished In -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Finished In:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayFinishedIn}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Playtime (mặc định) -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Playtime:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPlayTime}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Avg Playtime (mặc định) -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Avg Play:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayAvgPlayTime}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- ===== ADDITIONAL INFO ===== (chèn vào giữa, margin 10) -->
                                            <!-- Series -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Series:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Series}" FontSize="12"/>
                                            </Grid>

                                            <!-- Developer -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Developer:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Developer}" FontSize="12"/>
                                            </Grid>

                                            <!-- Publisher -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Publisher:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12"/>
                                            </Grid>

                                            <!-- Playtime bổ sung (khi sort) - đã có mặc định nên không cần -->
                                            <!-- Excited -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Excited:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" FontSize="12"/>
                                            </Grid>

                                            <!-- Ownership -->
                                            <Grid Margin="0,0,0,10"
                                                  Visibility="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ownership:" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayOwnership}" FontSize="12"/>
                                            </Grid>

                                            <!-- AvgPlaytime bổ sung (khi sort) - đã có mặc định nên không cần, có thể bỏ qua -->

                                            <!-- Published (giữ nguyên margin 16) -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Published:"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayPublishYear}"
                                                           FontSize="12"/>
                                            </Grid>

                                        </StackPanel>
                                    </Grid>

                                    <!-- ==================== CARD FOOTER ==================== -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Folder warning: chỉ hiện ở Default mode -->
                                        <Grid Grid.Column="0"
                                              Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <Image Width="18"
                                                   Height="18"
                                                   VerticalAlignment="Center"
                                                   Source="/Assets/Problem.png"
                                                   Margin="2,2,2,2"
                                                   Stretch="Fill"
                                                   SnapsToDevicePixels="True"
                                                   UseLayoutRounding="True"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   RenderOptions.EdgeMode="Aliased"
                                                   Visibility="{Binding ShowFolderWarning, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal">
                                            <Button Style="{StaticResource PlayButtonStyle}"
                                                    Click="PlayGame_Click"
                                                    Margin="0,0,10,0"
                                                    Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}">
                                                <Image Width="16"
                                                       Height="16"
                                                       Source="/Assets/Play.png"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>

                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Background="#3291B6"
                                                    Click="EditGame_Click">
                                                <Image Source="/Assets/Info.png"
                                                       Width="16"
                                                       Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="25,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <TextBlock Grid.Column="0"
                           x:Name="PaginationSummaryTextBlock"
                           Text="{Binding PaginationSummaryText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#666666"/>

                <!-- CENTER PAGINATION -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button x:Name="PrevPageButton"
                            Style="{StaticResource PaginationButtonStyle}"
                            Content="‹ Prev"
                            Click="PrevPageButton_Click"
                            IsEnabled="{Binding CanGoPrev}"/>

                    <TextBlock x:Name="PageInfoTextBlock"
                               Text="{Binding PageInfoText}"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"/>

                    <Button x:Name="NextPageButton"
                            Style="{StaticResource PaginationButtonStyle}"
                            Content="Next ›"
                            Click="NextPageButton_Click"
                            IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="MasterPlay by Vidagrr @2026" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text=" | " Margin="10,0" Foreground="#666666"/>
                    <TextBlock Text="Version 1.2" FontSize="12" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
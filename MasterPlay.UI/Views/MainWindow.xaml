<Window x:Class="MasterPlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="MasterPlay" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Image Source="/Assets/MasterplayLogo.png" HorizontalAlignment="Left" Width="140" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" Style="{StaticResource ModernSearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged"
                         Margin="0,0,10,0"/>
                <ComboBox x:Name="SortComboBox" Width="105" Style="{StaticResource ModernComboBoxStyle}"
                          SelectionChanged="SortComboBox_SelectionChanged"
                          SelectedIndex="0" Margin="0,0,20,0">
                    <ComboBoxItem Content="Filter"/>
                    <ComboBoxItem Content="Status"/>
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Playtime"/>
                </ComboBox>
                <Button Style="{StaticResource IconButtonStyle}" Background="#A1BC98" Click="AddGameButton_Click">
                    <Image Source="/Assets/Add.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0" Click="SettingsButton_Click">
                    <Image Source="/Assets/Setting.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Gallery -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GamesGallery" ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" 
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"
                                     Margin="0,0,0,10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Border Background="White" CornerRadius="12" BorderBrush="#F0F0F0" BorderThickness="1"
                                Margin="8" Padding="12" MinHeight="280" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Black" Direction="320" ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FCF9"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="4" BlurRadius="12" Opacity="0.25"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Ảnh game 16:9 -->
                                    <RowDefinition Height="*"/>
                                    <!-- Phần dưới -->
                                </Grid.RowDefinitions>

                                <!-- Ảnh game: responsive 16:9, high res, CacheOption OnLoad -->
                                <Viewbox Grid.Row="0" Stretch="Uniform" Margin="-12,-12,-12,12">
                                    <Grid Width="320" Height="180">
                                        <!-- Mẫu tỉ lệ 16:9 -->
                                        <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Source>
                                                    <BitmapImage UriSource="{Binding Game.ImagePath, FallbackValue='/Assets/DefaultGameCover.png'}"
                                                                 CacheOption="OnLoad"
                                                                 CreateOptions="IgnoreImageCache"
                                                                 DecodePixelWidth="640" />
                                                    <!-- DecodePixelWidth lớn để load high-res -->
                                                </Image.Source>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </Viewbox>

                                <!-- Nội dung dưới: tên, playtime, danger icon + buttons cùng hàng dưới -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid>
                                        <!-- Icon Danger: nhỏ, căn ngang với nút, bên trái -->
                                        <Grid Width="18" Height="18"
                                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                              Margin="0,0,0,8"
                                              Visibility="{Binding ShowFolderWarning, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Fill="#F5AD18">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Danger.png"
                                                                Stretch="Uniform"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>

                                        <!-- Tên + Play time -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Game.Name}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MainTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,4"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Play time: " FontSize="11" Foreground="#79C9C5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayPlayTime}"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource SubTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Nút Play + Edit: sát mép dưới -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" 
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,8">
                                            <Button Style="{StaticResource PlayButtonStyle}"
                                                    Width="36" Height="36"
                                                    IsEnabled="{Binding IsGameRunning, Converter={StaticResource BoolInverse}}"
                                                    Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}"
                                                    Click="PlayGame_Click"
                                                    Margin="0,0,12,0">
                                                <Image Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="/Assets/Play.png"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                                    <Setter Property="Source" Value="/Assets/Playing.png"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Button>

                                            <Button Style="{StaticResource IconButtonStyle}" 
                                                    Background="#3291B6" 
                                                    Width="36" Height="36"
                                                    Click="EditGame_Click">
                                                <Image Source="/Assets/Info.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
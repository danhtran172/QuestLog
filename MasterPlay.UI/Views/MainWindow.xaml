                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Excited:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>

                                                <!-- Ownership -->
                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ownership:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayOwnership}" Foreground="{Binding Game.Ownership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>

                                                <!-- Published -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Published:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishYear}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Card footer -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder warning -->
                                            <Grid Grid.Column="0" Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Image Width="18" Height="18" VerticalAlignment="Center" Source="/Assets/Problem.png" Margin="2,2,2,2" Stretch="Fill" ToolTip="{Binding FolderWarningInfo}"
                                                       SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"
                                                       Visibility="{Binding ShowFolderWarning, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PlayButtonStyle}" 
            Click="PlayGame_Click" 
            Margin="0,0,10,0"
            Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}"
            IsEnabled="{Binding IsGameRunning, Converter={StaticResource BoolInverse}}">
                                                    <Image Width="16" Height="16" 
               Source="/Assets/Play.png" 
               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                                <Button Style="{StaticResource InfoButtonStyle}" Click="EditGame_Click">
                                                    <Image Source="/Assets/Info.png" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- List view (PlayQueue) -->
            <Border x:Name="ListBorder"
                    Grid.Row="1"
                    Margin="5"
                    Visibility="{Binding IsPlayQueueMode, Converter={StaticResource BoolToVis}}">
                <local:QueueView/>
            </Border>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="25,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <TextBlock Grid.Column="0"
                   x:Name="PaginationSummaryTextBlock"
                   Text="{Binding PaginationSummaryText}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="#666666"/>

                <!-- CENTER PAGINATION (ẩn khi PlayQueue) -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,0,16,0"
                    Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                    <Button x:Name="PrevPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="‹ Prev"
                    Click="PrevPageButton_Click"
                    IsEnabled="{Binding CanGoPrev}"/>
                    <TextBlock x:Name="PageInfoTextBlock"
                       Text="{Binding PageInfoText}"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#555555"/>
                    <Button x:Name="NextPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="Next ›"
                    Click="NextPageButton_Click"
                    IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock Text="MasterPlay by Vidagrr @2026" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text=" | " Margin="10,0" Foreground="#666666"/>
                    <TextBlock Text="Version 1.3" FontSize="12" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
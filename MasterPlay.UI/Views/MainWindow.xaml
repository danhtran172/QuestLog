<Window x:Class="MasterPlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="MasterPlay" Height="700" Width="920" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Escape" 
                Command="{Binding ToggleSettingsCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>
            <Grid Margin="25,12">
                <Image Source="/Assets/MasterplayLogo.png" HorizontalAlignment="Left" Width="140" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Search box + dropdown -->
                    <Border Width="250" Height="40" Background="Transparent" CornerRadius="20">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernSearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="0,0,100,0"
                             Margin="0"/>

                            <!-- Search By -->
                            <Border HorizontalAlignment="Right" Width="94" Height="40" Margin="0,0,1.5,0" Background="Transparent" >
                                <ComboBox x:Name="SearchByComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedIndex="0"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  Padding="0"
                                  
                                  SelectionChanged="SearchByComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Series"/>
                                    <ComboBoxItem Content="Publisher"/>
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Release"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- View Mode -->
                    <ComboBox x:Name="ViewModeComboBox" Width="100" Style="{StaticResource ModernComboBoxStyle}"
                      SelectionChanged="ViewModeComboBox_SelectionChanged"
                      Tag="/Assets/ViewMode2.png"
                      SelectedIndex="0" Margin="10,0,10,0">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Plan"/>
                        <ComboBoxItem Content="Finish"/>
                    </ComboBox>
                    <!-- Sort -->
                    <ComboBox x:Name="SortComboBox" Width="100" Style="{StaticResource ModernComboBoxStyle}"
                      SelectionChanged="SortComboBox_SelectionChanged"
                      Tag="/Assets/Sort.png"
                      SelectedIndex="0" Margin="0,0,20,0">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Status"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Playtime"/>
                        <ComboBoxItem Content="Publish"/>
                    </ComboBox>

                    <Button Style="{StaticResource IconButtonStyle}" Background="#A1BC98" Click="AddGameButton_Click">
                        <Image Source="/Assets/Add.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0" Click="SettingsButton_Click">
                        <Image Source="/Assets/Setting.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GALLERY ==================== -->
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Margin="5">

            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">

                        <Border Width="270"
                        Margin="6"
                        Background="White"
                        BorderBrush="#E4E4E4"
                        BorderThickness="1"
                        CornerRadius="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- IMAGE (bo 2 góc trên, ratio 460x215) -->
                                <Border Grid.Row="0"
                                Height="126.2"
                                CornerRadius="14,14,0,0"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Game.GImagePath, Converter={StaticResource SteamImgConv}}"
                                            Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- CONTENT -->
                                <Grid Grid.Row="1" Margin="14">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- TITLE -->
                                    <TextBlock Grid.Row="0"
                                       Text="{Binding DisplayName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                                    <!-- PUBLISHED -->
                                    <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,10">          
                                        <TextBlock Text="Published: "
                                           FontWeight="Bold"
                                           FontSize="12"/>
                                        <TextBlock Text="{Binding DisplayPublishYear}"
                                        FontSize="12"/>
                                    </StackPanel>

                                    <!-- PUBLISHER -->
                                    <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="Publisher: "
                                           FontWeight="Bold"
                                           FontSize="12"/>          
                                        <TextBlock Text="{Binding DisplayPublisher}"
                                        FontSize="12"/>
                                    </StackPanel>

                                    <!-- PLAYTIME -->
                                    <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                                        <TextBlock Text="Playtime: "
                                           FontWeight="Bold"
                                           FontSize="12"/>
                                        <TextBlock Text="{Binding DisplayPlayTime}"
                                            FontSize="12"/>
                                    </StackPanel>

                                    <!-- PROGRESS -->
                                    <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,16">
                                    <TextBlock Text="Progress: "
                                       FontWeight="Bold"
                                       FontSize="12"/>
                                    <TextBlock Text="{Binding DisplayProgress}"
                                       FontSize="12"/>
                                    </StackPanel>

                                    <!-- FOOTER ROW -->
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Folder danger -->
                                        <Image Width="18"
                                           Height="18"
                                           VerticalAlignment="Center"
                                           Source="/Assets/Problem.png"
                                           Margin="2,2,2,2"
                                           Stretch="Fill"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        RenderOptions.EdgeMode="Aliased"/>

                                        <!-- Buttons -->
                                        <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">

                                            <Button Style="{StaticResource PlayButtonStyle}"
                                            Click="PlayGame_Click"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}">
                                                <Image Width="16"
                                               Height="16"
                                               Source="/Assets/Play.png"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>

                                            <Button Style="{StaticResource IconButtonStyle}"
                                            Background="#3291B6"
                                            Click="EditGame_Click">
                                                <Image Source="/Assets/Info.png"
                                               Width="16"
                                               Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="25,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pagination summary -->
                <TextBlock Grid.Column="0"
                   x:Name="PaginationSummaryTextBlock"
                   Text="{Binding PaginationSummaryText}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="#666666"/>

                <!-- Pagination controls -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">
                    <Button x:Name="PrevPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="‹ Prev"
                    Click="PrevPageButton_Click"
                    IsEnabled="{Binding CanGoPrev}"/>

                    <TextBlock x:Name="PageInfoTextBlock"
                       Text="{Binding PageInfoText}"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#555555"/>

                    <Button x:Name="NextPageButton"
                    Style="{StaticResource PaginationButtonStyle}"
                    Content="Next ›"
                    Click="NextPageButton_Click"
                    IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>

                <!-- App info -->
                <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock Text="MasterPlay by Vidagrr @2026" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text=" | " Margin="10,0" Foreground="#666666"/>
                    <TextBlock Text="Version 1.1" FontSize="12" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
<Window x:Class="MasterPlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="MasterPlay"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI, Segoe UI Emoji"
        KeyDown="Window_KeyDown"
        xmlns:local="clr-namespace:MasterPlay.UI.Views"
        xmlns:controls="clr-namespace:MasterPlay.UI.Controls"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">


    <Window.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding ToggleSettingsCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <Color x:Key="HighlightColor">#FFFFE0</Color>
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" Opacity="0.5"/>


        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="#E0E0E0" BorderThickness="0"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="18">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="25"/>
                                                </Grid.ColumnDefinitions>
                                                <Image x:Name="Icon"
                                               Grid.Column="0" Width="14" Height="14"
                                               Margin="10,0,6,0" VerticalAlignment="Center"
                                               Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <ContentPresenter x:Name="Content"
                                                          Grid.Column="1"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path Grid.Column="2"
                                              Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                              Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Content" Property="Grid.Column" Value="0"/>
                                                <Setter TargetName="Content" Property="Grid.ColumnSpan" Value="3"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide"
                           Focusable="False">
                                <Border Background="White"
                                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="12"
                                Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <StackPanel>

                                        <ItemsPresenter SnapsToDevicePixels="True"/>

                                        <CheckBox x:Name="ReverseCheckBox"
                                          Content="Reverse"
                                          Margin="8,4,8,8"
                                          IsChecked="{Binding DataContext.IsReverseSort, RelativeSource={RelativeSource AncestorType=Window}}"
                                          VerticalAlignment="Center"
                                          FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>

            <Grid Margin="20,0,20,0" Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left">
                        <Button Content="Default" Command="{Binding ShowAllCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Planing" Command="{Binding ShowPlanningCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlanMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Finished" Command="{Binding ShowFinishedCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFinishMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="PlayQueue" Command="{Binding ShowPlayQueueCommand}" MinWidth="70">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayQueueMode}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                            <Setter Property="BorderBrush" Value="#A1BC98"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>


                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Width="220" Height="30" Background="Transparent" CornerRadius="20"
                            Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource ModernSearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,100,0"
                                     />
                            <Border HorizontalAlignment="Right" Width="94" Height="28" Margin="0,0,1,0" Background="Transparent">
                                <ComboBox x:Name="SearchByComboBox"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="0"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          VerticalContentAlignment="Center"
                                          HorizontalContentAlignment="Center"
                                          Padding="0"
                                          SelectionChanged="SearchByComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Series"/>
                                    <ComboBoxItem Content="Publisher"/>
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Release"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </Border>


                    <ComboBox x:Name="SortComboBox"
                              Width="115"
                              Style="{StaticResource SortComboBoxStyle}"
                              SelectionChanged="SortComboBox_SelectionChanged"
                              Tag="/Assets/Sort.png"
                              SelectedIndex="0"
                              Margin="10,0,5,0"
                              Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Status"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Playtime"/>
                        <ComboBoxItem Content="Publish"/>
                        <ComboBoxItem Content="MetaScore"/>
                        <ComboBoxItem Content="Excited"/>
                        <ComboBoxItem Content="Score"/>
                        <ComboBoxItem Content="Ownership"/>
                        <ComboBoxItem Content="Progress"/>
                        <ComboBoxItem Content="AvgPlaytime"/>
                    </ComboBox>

                    <ToggleButton x:Name="FilterToggleButton"
                                  Style="{StaticResource FilterButtonStyle}"
                                  Background="Transparent"
                                  Margin="0,0,5,0"
                                  Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}"/>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#A1BC98"
                            Command="{Binding AddGameCommand}">
                        <Image Source="/Assets/Add.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Background="#7F8C8D"
                            Margin="10,0,0,0"
                            Command="{Binding OpenSettingsCommand}">
                        <Image Source="/Assets/Setting.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <Popup x:Name="FilterPopup"
               Placement="Center"
               StaysOpen="False"
               PopupAnimation="Slide"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=FilterToggleButton}">
            <controls:FilterPanel CloseRequested="FilterPanel_CloseRequested"/>
        </Popup>


        <Grid Grid.Row="1" Margin="5">

            <ScrollViewer x:Name="CardScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsPlayQueueMode, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameViewModel}">
                            <Border Width="270"
                                    Margin="6"
                                    Background="White"
                                    BorderBrush="#E4E4E4"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>


                                    <Border Grid.Row="0"
                                            Height="126.2"
                                            CornerRadius="14,14,0,0"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Game.GImagePath, Converter={StaticResource SteamImgConv}}"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border.Background>
                                    </Border>


                                    <Grid Grid.Row="1" Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="*"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>


                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,0,15"/>


                                        <Grid Grid.Row="2">

                                            <StackPanel Visibility="{Binding DataContext.IsAllMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Published:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishYear}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="MetaScore: " FontWeight="Bold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                                CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayMetaScore}" Foreground="#2C3E50" FontSize="12" FontWeight="Bold" Padding="2,0"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Publisher:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Playtime:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>



                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowSeries, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Series:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Game.Series}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowDeveloper, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Developer:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Game.Developer}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowPublisher, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Publisher:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublisher}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowPlaytime, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Playtime:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowExcited, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Excited:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowScore, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Score:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayScore}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowOwnership, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ownership:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayOwnership}" Foreground="{Binding Game.Ownership, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Ownership}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10"
                                                      Visibility="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShouldShowAvgPlaytime, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Avg Play:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayAvgPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Progress:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayProgress}" Foreground="{Binding Game.Progress, Converter={StaticResource SelectionColorConverter}, ConverterParameter=Progress}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>
                                            </StackPanel>


                                            <StackPanel Visibility="{Binding DataContext.IsPlanMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Published:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayPublishYear}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="MetaScore: " FontWeight="Bold" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Border Background="{Binding Game.MetaScore, Converter={StaticResource MetaScoreColorConverter}}"
                                                                CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayMetaScore}" Foreground="#2C3E50" FontSize="12" FontWeight="Bold" Padding="2,0"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Excited:" FontWeight="Bold" FontSize="12"/>
                                                    <emoji:TextBlock Grid.Column="1" Text="{Binding DisplayExcited}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontFamily="Segoe UI Emoji"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Avg Play:" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayAvgPlayTime}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                </Grid>


                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>

<Window x:Class="MasterPlay.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="MasterPlay" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        Background="#F8F9FA" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>
            <Grid Margin="25,20">
                <Image Source="/Assets/MasterplayLogo.png" HorizontalAlignment="Left" Width="140" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Search box + dropdown -->
                    <Border Width="250" Height="40" Background="Transparent" CornerRadius="20">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernSearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="0,0,100,0"
                             Margin="0"/>

                            <!-- Search By -->
                            <Border HorizontalAlignment="Right" Width="94" Height="40" Margin="0,0,1.5,0" Background="Transparent" >
                                <ComboBox x:Name="SearchByComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedIndex="0"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  Padding="0"
                                  
                                  SelectionChanged="SearchByComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Series"/>
                                    <ComboBoxItem Content="Publisher"/>
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Release"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- View Mode -->
                    <ComboBox x:Name="ViewModeComboBox" Width="100" Style="{StaticResource ModernComboBoxStyle}"
                      SelectionChanged="ViewModeComboBox_SelectionChanged"
                      Tag="/Assets/ViewMode2.png"
                      SelectedIndex="0" Margin="10,0,10,0">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Plan"/>
                        <ComboBoxItem Content="Finish"/>
                    </ComboBox>
                    <!-- Sort -->
                    <ComboBox x:Name="SortComboBox" Width="100" Style="{StaticResource ModernComboBoxStyle}"
                      SelectionChanged="SortComboBox_SelectionChanged"
                      Tag="/Assets/Sort.png"
                      SelectedIndex="0" Margin="0,0,20,0">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Status"/>
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Playtime"/>
                    </ComboBox>

                    <Button Style="{StaticResource IconButtonStyle}" Background="#A1BC98" Click="AddGameButton_Click">
                        <Image Source="/Assets/Add.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Background="#7F8C8D" Margin="10,0,0,0" Click="SettingsButton_Click">
                        <Image Source="/Assets/Setting.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GALLERY ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="25">
            <ItemsControl x:Name="GamesGallery" ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Grid Margin="8">
                            <Border x:Name="ShadowBorder" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="2" BlurRadius="8" Opacity="0.15"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="MainCardBorder" BorderBrush="#F0F0F0" BorderThickness="1"
                                    Background="White" MinHeight="280" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" ClipToBounds="True">
                                        <Viewbox Stretch="Uniform">
                                            <Grid Width="320" Height="180">
                                                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Source>
                                                        <BitmapImage UriSource="{Binding Game.ImagePath, FallbackValue='/Assets/DefaultGameCover.png'}"
                                                                     CacheOption="OnLoad" CreateOptions="IgnoreImageCache" DecodePixelWidth="640" />
                                                    </Image.Source>
                                                </Image>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="12,8,12,12">
                                        <StackPanel Margin="0,0,0,32">
                                            <TextBlock Text="{Binding Game.Name}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Play time: " FontSize="11" Foreground="#79C9C5" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayPlayTime}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Width="20" Height="20"
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,0,0"
                                              Visibility="{Binding ShowFolderWarning, Converter={StaticResource BoolToVis}}">
                                            <Rectangle Fill="#F5AD18">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Danger.png"
                                                                Stretch="Uniform"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource PlayButtonStyle}" Click="PlayGame_Click" Margin="0,0,12,0"
                                                    Visibility="{Binding HasPlayableExe, Converter={StaticResource BoolToVis}}">
                                                <Image Width="16" Height="16" Source="/Assets/Play.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" Background="#3291B6" Click="EditGame_Click">
                                                <Image Source="/Assets/Info.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="4" BlurRadius="12" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel Margin="25,15" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="MasterPlay - Vidagrr - 2026" FontSize="12" Foreground="#666666"/>
                <TextBlock Text=" | " Margin="10,0" Foreground="#666666"/>
                <TextBlock Text="Version 1.1" FontSize="12" Foreground="#666666"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
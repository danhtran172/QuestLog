<Window x:Class="MasterPlay.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterPlay.UI.ViewModels"
        Title="Settings" Height="780" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TITLE ==================== -->
        <TextBlock Grid.Row="0" Text="APPLICATION SETTINGS" FontSize="18" FontWeight="Bold" Foreground="#A1BC98" Margin="0,0,0,25"/>

        <!-- ==================== BACKUP ROOT PATH ==================== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Backup Root Path" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding BackupRootPath}" IsReadOnly="{Binding IsBackupReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditBackupCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ==================== CONFIG FILE PATH ==================== -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Config File Path" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ConfigPath}" IsReadOnly="{Binding IsConfigReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditConfigCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ==================== GAME DATA FILE PATH ==================== -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Game Data File Path" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding GameDataPath}" IsReadOnly="{Binding IsGameDataReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditGameDataCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ==================== META DATA FILE PATH ==================== -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Meta Data File Path" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding MetaDataPath}" IsReadOnly="{Binding IsMetaDataReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditMetaDataCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ==================== GALLERY FILE PATH ==================== -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Gallery File Path" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding GalleryFilePath}" IsReadOnly="{Binding IsGalleryReadOnly}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A" Command="{Binding EditGalleryCommand}" Margin="10,0,0,0">
                    <Image Source="/Assets/Edit Folder.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ==================== GAME LIBRARY PATHS ==================== -->
        <Grid Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Game Library Paths" FontWeight="SemiBold" Foreground="#555555" VerticalAlignment="Center"/>
            <Button Command="{Binding AddLibraryCommand}" HorizontalAlignment="Right" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#A2D5C6" CornerRadius="15" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Add.png" Width="16" Height="16" Margin="0,0,8,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Add Library" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#82A066"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5F754B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ==================== LIBRARY LIST ==================== -->
        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
            <ItemsControl ItemsSource="{Binding LibraryPaths}" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- TextBox library path - chiếm hết chiều rộng -->
                            <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>

                            <!-- Nút edit folder - bên phải text box -->
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="#FADA7A"
                                    Command="{Binding EditLibraryCommand}" Margin="10,0,5,0">
                                <Image Source="/Assets/Edit Folder.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Button>

                            <!-- Nút xóa library - vòng tròn đen, nằm cuối text box (bên phải nút edit) -->

                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="#BFC9D1"
                                        Command="{Binding DataContext.RemoveLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Padding="0">
                                    <Image Source="/Assets/Close.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
            
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== STATUS & BUTTONS ==================== -->
        <TextBlock Grid.Row="8" Text="{Binding StatusMessage}" Foreground="#E74C3C" FontStyle="Italic" FontSize="12" Margin="0,15,0,0"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource IconButtonStyle}" Background="#708A58" Command="{Binding SaveCommand}">
                <Image Source="/Assets/Save.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CancelCommand}" Margin="12,0,0,0">
                <Image Source="/Assets/Close.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
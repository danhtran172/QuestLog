---
// Loi keu goi cuoi trang. Nen nhac lai buc tuong anh bia cua hero (mo, toi)
// de khep trang bang chinh thu vien.
import { Image } from "astro:assets";
import wall from "../assets/app/wall.webp";
import { ui, type Locale } from "../i18n/ui";
import { DOWNLOAD_URL } from "../site";

interface Props {
  lang: Locale;
}

const t = ui[Astro.props.lang].download;
---

<section id="download" class="relative isolate overflow-hidden py-32 text-center lg:py-44" aria-labelledby="download-title">
  <div class="backdrop" aria-hidden="true">
    <Image src={wall} alt="" widths={[900, 1600]} sizes="100vw" quality={55} class="backdrop-img" />
  </div>
  <div class="container-page flex flex-col items-center">
    <p class="eyebrow" data-reveal>◆ {t.eyebrow}</p>
    <h2 id="download-title" class="display mt-5 max-w-[60rem] text-[clamp(2.7rem,6.6vw,5.4rem)] text-balance" data-reveal style="--d:80ms">
      {t.title}
    </h2>
    <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-mist/80" data-reveal style="--d:160ms">{t.body}</p>
    <div class="mt-10" data-reveal style="--d:240ms">
      <a href={DOWNLOAD_URL} class="btn-primary !px-8 !py-4 text-lg">
        <svg class="btn-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path>
        </svg>
        {t.cta}
      </a>
    </div>
    <p class="mt-5 font-mono text-xs tracking-wider text-fog" data-reveal style="--d:300ms">{t.requirements}</p>
    <p class="mt-3 max-w-[30rem] text-xs leading-relaxed text-fog" data-reveal style="--d:340ms">{t.unsigned}</p>
  </div>
</section>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .backdrop-img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(110vw, 1100px);
    max-width: none;
    height: auto;
    opacity: 0.32;
    filter: blur(3px) saturate(0.9);
    transform: translate(-50%, -50%) rotate(-8deg) scale(1.1);
  }

  /* Vien toi bon phia + quang xanh rieu giua: chu luon doc ro tren anh. */
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(48% 46% at 50% 52%, color-mix(in oklab, var(--color-abyss) 55%, transparent), var(--color-abyss) 100%),
      radial-gradient(40% 40% at 50% 60%, color-mix(in oklab, var(--color-quest) 18%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-abyss) 0%, transparent 25%, transparent 75%, var(--color-abyss) 100%);
  }
</style>

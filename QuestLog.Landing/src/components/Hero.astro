---
import { Image } from "astro:assets";
import wall from "../assets/app/wall.webp";
import GlancePanel from "./GlancePanel.astro";
import { ui, type Locale } from "../i18n/ui";
import { DOWNLOAD_URL } from "../site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].hero;
---

<section class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden pt-28 pb-44 lg:pb-60">
  <!-- Nen: trang dau thu vien (30 game cua tac gia), nghieng 3D va troi cham. -->
  <div class="hero-wall" aria-hidden="true">
    <div class="hero-wall__plane">
      <div class="hero-wall__drift">
        <Image src={wall} alt="" widths={[900, 1600]} sizes="(min-width: 1024px) 90vw, 160vw" quality={58} loading="eager" />
        <Image src={wall} alt="" widths={[900, 1600]} sizes="(min-width: 1024px) 90vw, 160vw" quality={58} loading="eager" />
      </div>
    </div>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container-page">
    <p class="eyebrow enter" style="--d:0ms">◆ {t.eyebrow}</p>
    <h1 class="display hero-title mt-6" aria-label={t.titlePlain}>
      {
        t.title.map((line, i) => (
          <span class="enter-blur block" style={`--d:${140 + i * 140}ms`} aria-hidden="true">
            {line.map((seg) => (seg.accent ? <span class="text-quest">{seg.text}</span> : seg.text))}
          </span>
        ))
      }
    </h1>
    <div class="mt-10 grid items-start gap-12 lg:mt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-16">
    <div>
      <p class="enter max-w-[36rem] text-lg leading-relaxed text-mist/80" style="--d:520ms">{t.subtitle}</p>
      <div class="enter mt-9 flex flex-col gap-3 sm:flex-row" style="--d:640ms">
        <a href={DOWNLOAD_URL} class="btn-primary">
          <svg class="btn-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path>
          </svg>
          {t.cta}
        </a>
        <a href="#timeline" class="btn-ghost">{t.secondary}</a>
      </div>
      <p class="enter mt-5 font-mono text-xs tracking-wider text-fog" style="--d:760ms">{t.note}</p>
    </div>

    <GlancePanel lang={lang} />
    </div>
  </div>
</section>

<style>
  /* Hai dong ngan, trai het be ngang: cau tra loi chinh cua trang. */
  .hero-title {
    font-size: clamp(3.2rem, 10.5vw, 9.5rem);
    line-height: 0.9;
  }

  .hero-title > span {
    white-space: nowrap;
  }

  :global(html[lang="vi"]) .hero-title {
    line-height: 1.04;
  }

  .hero-wall {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    perspective: 1500px;
  }

  .hero-wall__plane {
    position: absolute;
    top: -38%;
    left: 18%;
    width: max(92vw, 980px);
    transform: rotateX(42deg) rotateZ(-14deg);
    transform-origin: 50% 0;
    opacity: 0.58;
    animation: wall-in 2.4s var(--ease-out-quint) 0.05s both;
  }

  .hero-wall__drift {
    display: flex;
    flex-direction: column;
    animation: drift 150s linear infinite;
  }

  .hero-wall__drift img {
    display: block;
    width: 100%;
    height: auto;
  }

  @keyframes drift {
    to {
      transform: translateY(-50%);
    }
  }

  @keyframes wall-in {
    from {
      opacity: 0;
      transform: rotateX(42deg) rotateZ(-14deg) translateY(8%) scale(1.08);
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--color-abyss) 0%, transparent 22%, transparent 58%, var(--color-abyss) 96%),
      linear-gradient(
        90deg,
        var(--color-abyss) 0%,
        color-mix(in oklab, var(--color-abyss) 90%, transparent) 28%,
        color-mix(in oklab, var(--color-abyss) 40%, transparent) 62%,
        color-mix(in oklab, var(--color-abyss) 62%, transparent) 100%
      ),
      radial-gradient(55% 45% at 74% 58%, color-mix(in oklab, var(--color-quest) 20%, transparent), transparent 72%);
  }

  @media (max-width: 1023px) {
    .hero-wall__plane {
      left: -10%;
      top: -20%;
      width: 170vw;
      opacity: 0.4;
    }

    .hero-shade {
      background:
        linear-gradient(180deg, var(--color-abyss) 0%, color-mix(in oklab, var(--color-abyss) 70%, transparent) 30%, color-mix(in oklab, var(--color-abyss) 78%, transparent) 70%, var(--color-abyss) 100%),
        radial-gradient(70% 40% at 60% 75%, color-mix(in oklab, var(--color-quest) 16%, transparent), transparent 75%);
    }
  }
</style>

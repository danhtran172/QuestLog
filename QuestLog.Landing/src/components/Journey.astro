---
// Dong thoi gian: da choi -> dang choi -> sap choi. Thu tu nay la that (qua
// khu -> hien tai -> tuong lai) nen moi chang duoc danh so va noi bang duong ray.
import { Image } from "astro:assets";
import Stop from "./Stop.astro";
import TrayCard from "./TrayCard.astro";
import ConsoleBand from "./ConsoleBand.astro";
import { shot } from "../shots";
import { ui, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { timeline, shots } = ui[lang];
const [played, playing, next] = timeline.stops;
---

<section id="timeline" class="scroll-mt-16 pt-28 lg:pt-40" aria-labelledby="timeline-title">
  <header class="container-page grid grid-cols-[var(--rail)_1fr]">
    <div class="relative">
      <span class="route-start" data-route-point></span>
    </div>
    <div class="max-w-[46rem]" data-reveal>
      <p class="eyebrow">◆ {timeline.eyebrow}</p>
      <h2 id="timeline-title" class="display mt-5 text-[clamp(2.8rem,6.4vw,5.2rem)] text-balance">{timeline.title}</h2>
      <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-mist/80">{timeline.intro}</p>
    </div>
  </header>

  <Stop stop={played} index={0}>
    <div class="frame frame--fade mx-auto max-w-[40rem]">
      <Image
        src={shot(lang, "dashboard")}
        alt={shots.dashboard}
        widths={[640, 960, 1280, 1568]}
        sizes="(min-width: 1024px) 640px, 92vw"
        quality={90}
        class="block h-auto w-full"
      />
    </div>
  </Stop>

  <Stop stop={playing} index={1} flip>
    <div class="relative mx-auto max-w-[36rem] pb-28 pl-6 sm:pb-20 sm:pl-12">
      <Image
        src={shot(lang, "detail")}
        alt={shots.detail}
        widths={[560, 840, 1120, 1680]}
        sizes="(min-width: 1024px) 520px, 86vw"
        quality={90}
        class="dialog-shot relative block h-auto w-full"
      />
      <TrayCard lang={lang} class="absolute bottom-0 left-0 w-[64%] -rotate-2 sm:w-[18.5rem]" />
    </div>
  </Stop>

  <ConsoleBand lang={lang} />

  <Stop stop={next} index={2}>
    <div class="relative pb-24 sm:pb-20 lg:pb-14">
      <div class="frame">
        <Image
          src={shot(lang, "queue")}
          alt={shots.queue}
          widths={[700, 1000, 1400, 2000]}
          sizes="(min-width: 1200px) 660px, (min-width: 1024px) 55vw, 88vw"
          quality={90}
          class="block h-auto w-full"
        />
      </div>
      <Image
        src={shot(lang, "releases")}
        alt={shots.releases}
        widths={[340, 520, 780]}
        sizes="(min-width: 1024px) 300px, 58vw"
        quality={90}
        class="popover-shot absolute right-[-2%] bottom-0 w-[58%] rotate-[2deg] sm:w-[46%]"
      />
    </div>
  </Stop>

  <!-- Duoi dong thoi gian: tuong lai con mo, net dut mo dan. -->
  <div class="container-page grid grid-cols-[var(--rail)_1fr]" aria-hidden="true">
    <div class="relative h-28"><span class="absolute bottom-0 left-1/2 h-px w-px" data-route-point></span></div>
  </div>
</section>

<style>
  .route-start {
    position: absolute;
    z-index: 3;
    top: 0.3rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-parchment);
    box-shadow: 0 0 0 6px var(--color-abyss);
    transform: translateX(-50%) rotate(45deg);
  }

  .frame {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 14px;
    background: #26292e;
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.95);
  }

  .frame--fade {
    mask-image: linear-gradient(180deg, #000 70%, transparent 99%);
  }

  /* Anh chup dialog/popover: bo goc theo ti le cua dialog trong app. */
  .dialog-shot,
  .popover-shot {
    height: auto;
    border-radius: 1.8% / 1.7%;
    box-shadow:
      0 50px 100px -30px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .popover-shot {
    border-radius: 4.5% / 5%;
  }
</style>

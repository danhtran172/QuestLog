---
import { Image } from "astro:assets";
import Stop from "./Stop.astro";
import TrayCard from "./TrayCard.astro";
import ConsoleBand from "./ConsoleBand.astro";
import { shot } from "../shots";
import { ui, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { journey, shots, quest } = ui[lang];
const [planned, nextplay, playing, done] = journey.stops;
---

<section id="journey" class="scroll-mt-16 pt-28 lg:pt-40" aria-labelledby="journey-title">
  <header class="container-page grid grid-cols-[var(--rail)_1fr]">
    <div class="relative">
      <span class="route-start" data-route-point></span>
    </div>
    <div class="max-w-[44rem]" data-reveal>
      <p class="eyebrow">◆ {journey.eyebrow}</p>
      <h2 id="journey-title" class="display mt-5 text-[clamp(2.8rem,6.4vw,5.2rem)] text-balance">{journey.title}</h2>
      <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-mist/80">{journey.intro}</p>
    </div>
  </header>

  <Stop stop={planned} index={0} bleed>
    <div class="frame frame--fade">
      <Image
        src={shot(lang, "list")}
        alt={shots.list}
        widths={[700, 1000, 1400, 2000]}
        sizes="(min-width: 1024px) 60vw, 88vw"
        class="block h-auto w-full"
      />
    </div>
  </Stop>

  <Stop stop={nextplay} index={1} flip>
    <div class="relative pb-20 sm:pb-24 lg:pb-16">
      <div class="frame">
        <Image
          src={shot(lang, "queue")}
          alt={shots.queue}
          widths={[700, 1000, 1400, 2000]}
          sizes="(min-width: 1200px) 660px, (min-width: 1024px) 55vw, 88vw"
          class="block h-auto w-full"
        />
      </div>
      <Image
        src={shot(lang, "filter")}
        alt={shots.filter}
        widths={[340, 520, 700]}
        sizes="(min-width: 1024px) 280px, 46vw"
        class="dialog-shot absolute right-[-3%] bottom-0 w-[46%] rotate-[2.5deg] sm:w-[42%]"
      />
    </div>
  </Stop>

  <Stop stop={playing} index={2}>
    <div class="relative mx-auto max-w-[34rem] pb-24 pl-8 sm:pb-16 sm:pl-14">
      <Image
        src={shot(lang, "detail")}
        alt={shots.detail}
        widths={[540, 800, 1100, 1600]}
        sizes="(min-width: 1024px) 480px, 82vw"
        class="dialog-shot relative block h-auto w-full"
      />
      <TrayCard lang={lang} class="absolute bottom-0 left-0 w-[60%] -rotate-2 sm:w-[18.5rem]" />
    </div>
  </Stop>

  <ConsoleBand lang={lang} />

  <Stop stop={done} index={3} flip>
    <div class="trophy relative mx-auto flex max-w-[30rem] justify-center pt-10 pb-6">
      <Image
        src={shot(lang, "card-done")}
        alt={shots.cardDone}
        widths={[300, 602]}
        sizes="(min-width: 1024px) 300px, 62vw"
        class="card-shot relative w-[66%] max-w-[300px] -rotate-3"
      />
      <div class="hud quest-toast absolute top-0 right-0 px-5 py-4" aria-hidden="true">
        <p class="eyebrow text-done">◆ {quest.label}</p>
        <p class="mt-1.5 font-semibold text-mist">{quest.game}</p>
        <p class="mt-0.5 font-mono text-xs text-fog">{quest.meta}</p>
      </div>
    </div>
  </Stop>
</section>

<style>
  .route-start {
    position: absolute;
    z-index: 3;
    top: 0.3rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-parchment);
    box-shadow: 0 0 0 6px var(--color-abyss);
    transform: translateX(-50%) rotate(45deg);
  }

  .frame {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 14px;
    background: #26292e;
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.95);
  }

  .frame--fade {
    mask-image: linear-gradient(180deg, #000 62%, transparent 98%);
  }

  /* Anh chup dialog: bo goc dung ti le dialog trong app (16px). */
  .dialog-shot {
    height: auto;
    border-radius: 1.8% / 1.7%;
    box-shadow:
      0 50px 100px -30px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .card-shot {
    height: auto;
    border-radius: 5.98% / 5.23%;
    box-shadow:
      0 50px 90px -30px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }

  /* Hao quang "hoan thanh" sau card. */
  .trophy::before {
    content: "";
    position: absolute;
    inset: 4% 10%;
    border-radius: 50%;
    background:
      repeating-conic-gradient(from 0deg, color-mix(in oklab, var(--color-done) 20%, transparent) 0deg 6deg, transparent 6deg 18deg);
    mask-image: radial-gradient(closest-side, #000 35%, transparent);
  }

  .quest-toast {
    border-color: color-mix(in oklab, var(--color-done) 35%, transparent);
  }

  .quest-toast::before,
  .quest-toast::after {
    border-color: var(--color-done);
  }

  @media (prefers-reduced-motion: no-preference) {
    .trophy::before {
      animation: spin 60s linear infinite;
    }
  }

  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
</style>

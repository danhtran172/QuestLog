---
// Bang nhiem vu kieu HUD trong game. So lieu lay tu thu vien that:
// Black Flag Resynced dang choi 40h, thoi luong trung binh 42h.
import { ui, type Locale } from "../i18n/ui";

interface Props {
  lang: Locale;
}

const t = ui[Astro.props.lang].tracker;
const [collect, queue, play, finish] = t.objectives;
---

<aside class="hud tracker enter w-full max-w-[26rem] justify-self-center p-6 sm:p-7 lg:justify-self-end" style="--d:380ms">
  <div class="flex items-center justify-between gap-4">
    <p class="eyebrow">◆ {t.label}</p>
    <p class="font-mono text-xs text-fog">
      <span class="tracker-count" aria-hidden="true"></span><span class="sr-only">2</span> / 4
    </p>
  </div>
  <p class="display mt-3 text-[2.15rem] text-mist">{t.title}</p>

  <ol class="mt-5 space-y-4 border-t border-line/80 pt-5 text-[0.95rem] leading-snug">
    <li class="obj is-done" style="--t:1000ms">
      <span class="box"><svg viewBox="0 0 16 16" aria-hidden="true"><path pathLength="1" d="M3.5 8.5 6.6 11.5 12.5 4.8"></path></svg></span>
      <span class="obj-text">{collect}</span>
    </li>
    <li class="obj is-done" style="--t:1350ms">
      <span class="box"><svg viewBox="0 0 16 16" aria-hidden="true"><path pathLength="1" d="M3.5 8.5 6.6 11.5 12.5 4.8"></path></svg></span>
      <span class="obj-text">{queue}</span>
    </li>
    <li class="obj is-active">
      <span class="box"><span class="gem"></span></span>
      <div class="min-w-0">
        <span class="text-mist">{play}</span>
        <div class="mt-2.5 flex items-center gap-3">
          <span class="bar" role="img" aria-label={`${t.progressLabel}: 40h / 42h`}><span class="bar-fill"></span></span>
          <span class="font-mono text-xs text-fog" aria-hidden="true">40h / 42h</span>
        </div>
      </div>
    </li>
    <li class="obj">
      <span class="box"></span>
      <span class="text-fog">{finish}</span>
    </li>
  </ol>
</aside>

<style>
  @property --n {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }

  /* --n khong ke thua (inherits: false) nen counter-reset phai dat tren chinh
     phan tu, ::after chi doc lai bo dem. */
  .tracker-count {
    --n: 2;
    counter-reset: n var(--n);
    animation: count 0.7s 0.65s both;
  }

  .tracker-count::after {
    content: counter(n);
  }

  @keyframes count {
    0% {
      --n: 0;
      animation-timing-function: steps(1, end);
    }
    50% {
      --n: 1;
      animation-timing-function: steps(1, end);
    }
    100% {
      --n: 2;
    }
  }

  .obj {
    display: grid;
    grid-template-columns: 1.15rem 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .box {
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.08rem;
    border: 1.5px solid color-mix(in oklab, var(--color-fog) 55%, transparent);
    border-radius: 4px;
  }

  .is-done .box {
    border-color: var(--color-quest);
    background: color-mix(in oklab, var(--color-quest) 16%, transparent);
    animation: box-on 0.4s var(--t) both;
  }

  .box svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: var(--color-quest);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.45s var(--ease-out-quint) var(--t) forwards;
  }

  .obj-text {
    position: relative;
    justify-self: start;
    color: var(--color-fog);
  }

  /* Gach ngang khi muc tieu hoan thanh, ve tu trai sang. */
  .obj-text::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    height: 1.5px;
    background: color-mix(in oklab, var(--color-fog) 70%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    animation: strike 0.5s var(--ease-out-quint) calc(var(--t) + 150ms) forwards;
  }

  .is-active .box {
    border-color: var(--color-parchment);
  }

  .gem {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--color-parchment);
    transform: rotate(45deg);
  }

  .bar {
    position: relative;
    display: block;
    width: 9.5rem;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-line);
  }

  .bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 95%;
    border-radius: inherit;
    background: linear-gradient(90deg, color-mix(in oklab, var(--color-quest) 70%, black), var(--color-quest));
    transform-origin: left;
    animation: fill 1.3s var(--ease-out-quint) 1.5s both;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes box-on {
    from {
      border-color: color-mix(in oklab, var(--color-fog) 55%, transparent);
      background: transparent;
    }
  }

  @keyframes strike {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }
</style>
